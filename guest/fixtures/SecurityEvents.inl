extern "C" Bool AvReadEventLogW(Handle h,Dword flags,Dword offset,void* out,Dword bytes,Dword* read,Dword* needed){if(!read||!needed||flags!=5||offset)return Fail(50);*read=*needed=0;EventCursor* cursor=nullptr;for(auto& c:eventCursors)if(c.h==h)cursor=&c;if(!cursor)return Fail(6);security::Request r;r.op=security::Op::EventRead;r.handle=uint64_t(h);r.index=cursor->index;auto e=GuardianSecurityCall(&r);if(e)return Fail(e);const auto sourceBytes=(Length(r.name)+1)*2,textBytes=(Length(r.text)+1)*2;const auto sid=MakeSid(r.flags);const auto sidBytes=SidBytes(&sid);const auto sidOffset=(56+sourceBytes+4+3)&~3u;const auto stringOffset=sidOffset+sidBytes;const auto total=(stringOffset+textBytes+4+3)&~3u;*needed=total;if(!out||bytes<total)return Fail(122);auto* b=static_cast<uint8_t*>(out);for(uint32_t i=0;i<total;++i)b[i]=0;const Dword header[6]={total,0x654c664c,r.index,r.service.hint,r.service.hint,r.returned};Copy(b,header,24);const uint16_t types[4]={uint16_t(r.type),1,0,0};Copy(b+24,types,8);const Dword fields[6]={0,stringOffset,sidBytes,sidOffset,0,0};Copy(b+32,fields,24);Wide(r.name,reinterpret_cast<uint16_t*>(b+56));Wide(r.text,reinterpret_cast<uint16_t*>(b+stringOffset));Copy(b+sidOffset,&sid,sidBytes);Copy(b+total-4,&total,4);*read=total;*needed=0;++cursor->index;return 1;}
