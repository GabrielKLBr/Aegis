namespace {
struct Allocation {void* p;SIZE_T n;};Allocation allocations[128]{};
Allocation* AllocationOf(void* p){for(auto& a:allocations)if(p&&a.p==p)return &a;return nullptr;}
}
extern "C" void* WINAPI CmpCoTaskMemAlloc(SIZE_T n){if(n>(1u<<20))return nullptr;Guard g;for(auto& a:allocations)if(!a.p){a.p=HeapAlloc(GetProcessHeap(),0,n?n:1);a.n=n;return a.p;}return nullptr;}
extern "C" void WINAPI CmpCoTaskMemFree(void* p){if(!p)return;Guard g;if(auto* a=AllocationOf(p)){HeapFree(GetProcessHeap(),0,p);*a={};}}
extern "C" void* WINAPI CmpCoTaskMemRealloc(void* p,SIZE_T n){if(!p)return CmpCoTaskMemAlloc(n);if(!n){CmpCoTaskMemFree(p);return nullptr;}if(n>(1u<<20))return nullptr;Guard g;auto* a=AllocationOf(p);if(!a)return nullptr;auto* out=HeapReAlloc(GetProcessHeap(),0,p,n);if(out){a->p=out;a->n=n;}return out;}
extern "C" BSTR WINAPI CmpSysAllocStringLen(const OLECHAR* s,UINT n){if(n>32767)return nullptr;auto* p=static_cast<BYTE*>(CmpCoTaskMemAlloc(SIZE_T(n)*2+6));if(!p)return nullptr;const DWORD bytes=n*2;Copy(p,&bytes,4);auto* out=reinterpret_cast<BSTR>(p+4);if(s)Copy(out,s,bytes);else Zero(out,bytes);out[n]=0;return out;}
extern "C" BSTR WINAPI CmpSysAllocString(const OLECHAR* s){if(!s)return nullptr;const auto n=Length(s);return n<32768?CmpSysAllocStringLen(s,n):nullptr;}
extern "C" UINT WINAPI CmpSysStringLen(BSTR s){if(!s)return 0;Guard g;const auto* a=AllocationOf(reinterpret_cast<BYTE*>(s)-4);if(!a||a->n<6)return 0;DWORD n=0;Copy(&n,reinterpret_cast<BYTE*>(s)-4,4);return n<=a->n-6?n/2:0;}
extern "C" UINT WINAPI CmpSysStringByteLen(BSTR s){return CmpSysStringLen(s)*2;}
extern "C" void WINAPI CmpSysFreeString(BSTR s){if(s)CmpCoTaskMemFree(reinterpret_cast<BYTE*>(s)-4);}
extern "C" INT WINAPI CmpSysReAllocStringLen(BSTR* p,const OLECHAR* s,UINT n){if(!p)return FALSE;const auto out=CmpSysAllocStringLen(s,n);if(!out)return FALSE;CmpSysFreeString(*p);*p=out;return TRUE;}
extern "C" void WINAPI CmpVariantInit(VARIANTARG* v){if(v)Zero(v,sizeof(*v));}
extern "C" HRESULT WINAPI CmpVariantClear(VARIANTARG* v){if(!v)return E_INVALIDARG;if(v->vt&VT_ARRAY){const auto hr=CmpSafeArrayDestroy(v->parray);if(FAILED(hr))return hr;CmpVariantInit(v);return S_OK;}switch(v->vt){case VT_BSTR:CmpSysFreeString(v->bstrVal);break;case VT_UNKNOWN:if(v->punkVal)v->punkVal->Release();break;case VT_DISPATCH:if(v->pdispVal)v->pdispVal->Release();break;case VT_EMPTY:case VT_NULL:case VT_I2:case VT_I4:case VT_UI4:case VT_R8:case VT_BOOL:case VT_ERROR:break;default:return DISP_E_BADVARTYPE;}CmpVariantInit(v);return S_OK;}
extern "C" HRESULT WINAPI CmpVariantCopy(VARIANTARG* out,const VARIANTARG* in){if(!out||!in)return E_INVALIDARG;if(out==in)return S_OK;VARIANT temp=*in;if(in->vt&VT_ARRAY){temp.parray=nullptr;const auto copied=CmpSafeArrayCopy(in->parray,&temp.parray);if(FAILED(copied))return copied;const auto cleared=CmpVariantClear(out);if(FAILED(cleared)){CmpSafeArrayDestroy(temp.parray);return cleared;}*out=temp;return S_OK;}switch(in->vt){case VT_BSTR:temp.bstrVal=CmpSysAllocStringLen(in->bstrVal,CmpSysStringLen(in->bstrVal));if(!temp.bstrVal&&in->bstrVal)return E_OUTOFMEMORY;break;case VT_UNKNOWN:if(temp.punkVal)temp.punkVal->AddRef();break;case VT_DISPATCH:if(temp.pdispVal)temp.pdispVal->AddRef();break;case VT_EMPTY:case VT_NULL:case VT_I2:case VT_I4:case VT_UI4:case VT_R8:case VT_BOOL:case VT_ERROR:break;default:return DISP_E_BADVARTYPE;}const auto hr=CmpVariantClear(out);if(FAILED(hr)){CmpVariantClear(&temp);return hr;}*out=temp;return S_OK;}
extern "C" HRESULT WINAPI CmpVariantChangeType(VARIANTARG* out,const VARIANTARG* in,USHORT flags,VARTYPE type){if(!out||!in||flags)return E_INVALIDARG;if(type==in->vt)return CmpVariantCopy(out,in);VARIANT v{};v.vt=type;if(in->vt==VT_I2||in->vt==VT_I4||in->vt==VT_BOOL){const LONG n=in->vt==VT_I2?in->iVal:in->vt==VT_BOOL?(in->boolVal?-1:0):in->lVal;if(type==VT_I4)v.lVal=n;else if(type==VT_R8)v.dblVal=n;else if(type==VT_BOOL)v.boolVal=n?VARIANT_TRUE:VARIANT_FALSE;else if(type==VT_I2){if(n< -32768||n>32767)return DISP_E_OVERFLOW;v.iVal=SHORT(n);}else return DISP_E_TYPEMISMATCH;}else return DISP_E_TYPEMISMATCH;const auto hr=CmpVariantClear(out);if(SUCCEEDED(hr))*out=v;return hr;}
namespace {
struct Array {SAFEARRAY array;VARTYPE type;};Array* arrays[32]{};
Array* FindArray(SAFEARRAY* p){for(auto* a:arrays)if(a&&&a->array==p)return a;return nullptr;}
UINT Element(VARTYPE t){return t==VT_I4||t==VT_UI4?4:t==VT_R8?8:t==VT_BSTR?UINT(sizeof(BSTR)):t==VT_VARIANT?UINT(sizeof(VARIANT)):0;}
}
extern "C" SAFEARRAY* WINAPI CmpSafeArrayCreateVector(VARTYPE t,LONG low,ULONG count){const auto size=Element(t);if(!size||count>256||int64_t(low)+count>LONG_MAX)return nullptr;Guard g;for(auto& a:arrays)if(!a){a=Make<Array>();if(!a)return nullptr;a->type=t;a->array.cDims=1;a->array.cbElements=size;a->array.fFeatures=t==VT_BSTR?FADF_BSTR:t==VT_VARIANT?FADF_VARIANT:0;a->array.rgsabound[0]={count,low};a->array.pvData=HeapAlloc(GetProcessHeap(),HEAP_ZERO_MEMORY,count?count*size:1);if(!a->array.pvData){Free(a);a=nullptr;return nullptr;}return &a->array;}return nullptr;}
extern "C" HRESULT WINAPI CmpSafeArrayDestroy(SAFEARRAY* p){if(!p)return S_OK;auto* a=FindArray(p);if(!a)return E_INVALIDARG;if(p->cLocks)return DISP_E_ARRAYISLOCKED;for(ULONG i=0;i<p->rgsabound[0].cElements;++i){if(a->type==VT_BSTR)CmpSysFreeString(static_cast<BSTR*>(p->pvData)[i]);else if(a->type==VT_VARIANT){const auto hr=CmpVariantClear(static_cast<VARIANT*>(p->pvData)+i);if(FAILED(hr))return hr;}}Guard g;for(auto& slot:arrays)if(slot==a){HeapFree(GetProcessHeap(),0,p->pvData);slot=nullptr;Free(a);return S_OK;}return E_INVALIDARG;}
extern "C" UINT WINAPI CmpSafeArrayGetDim(SAFEARRAY* p){return FindArray(p)?1:0;}
extern "C" HRESULT WINAPI CmpSafeArrayGetLBound(SAFEARRAY* p,UINT dim,LONG* out){if(!FindArray(p)||dim!=1||!out)return E_INVALIDARG;*out=p->rgsabound[0].lLbound;return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayGetUBound(SAFEARRAY* p,UINT dim,LONG* out){if(!FindArray(p)||dim!=1||!out)return E_INVALIDARG;*out=p->rgsabound[0].lLbound+LONG(p->rgsabound[0].cElements)-1;return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayGetVartype(SAFEARRAY* p,VARTYPE* out){const auto* a=FindArray(p);if(!a||!out)return E_INVALIDARG;*out=a->type;return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayAccessData(SAFEARRAY* p,void** out){if(!FindArray(p)||!out||p->cLocks==ULONG_MAX)return E_INVALIDARG;++p->cLocks;*out=p->pvData;return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayUnaccessData(SAFEARRAY* p){if(!FindArray(p)||!p->cLocks)return E_INVALIDARG;--p->cLocks;return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayPutElement(SAFEARRAY* p,LONG* index,void* value){auto* a=FindArray(p);if(!a||!index||!value)return E_INVALIDARG;const int64_t offset=int64_t(*index)-p->rgsabound[0].lLbound;if(offset<0||offset>=p->rgsabound[0].cElements)return DISP_E_BADINDEX;auto* dest=static_cast<BYTE*>(p->pvData)+offset*p->cbElements;if(a->type==VT_BSTR){auto s=CmpSysAllocStringLen(static_cast<BSTR>(value),CmpSysStringLen(static_cast<BSTR>(value)));if(!s)return E_OUTOFMEMORY;CmpSysFreeString(*reinterpret_cast<BSTR*>(dest));*reinterpret_cast<BSTR*>(dest)=s;return S_OK;}if(a->type==VT_VARIANT)return CmpVariantCopy(reinterpret_cast<VARIANT*>(dest),static_cast<VARIANT*>(value));Copy(dest,value,p->cbElements);return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayGetElement(SAFEARRAY* p,LONG* index,void* out){auto* a=FindArray(p);if(!a||!index||!out)return E_INVALIDARG;const int64_t offset=int64_t(*index)-p->rgsabound[0].lLbound;if(offset<0||offset>=p->rgsabound[0].cElements)return DISP_E_BADINDEX;const auto* source=static_cast<const BYTE*>(p->pvData)+offset*p->cbElements;if(a->type==VT_BSTR){*static_cast<BSTR*>(out)=CmpSysAllocStringLen(*reinterpret_cast<BSTR const*>(source),CmpSysStringLen(*reinterpret_cast<BSTR const*>(source)));return *static_cast<BSTR*>(out)?S_OK:E_OUTOFMEMORY;}if(a->type==VT_VARIANT){CmpVariantInit(static_cast<VARIANT*>(out));return CmpVariantCopy(static_cast<VARIANT*>(out),reinterpret_cast<const VARIANT*>(source));}Copy(out,source,p->cbElements);return S_OK;}
extern "C" HRESULT WINAPI CmpSafeArrayCopy(SAFEARRAY* in,SAFEARRAY** out){if(!out)return E_POINTER;*out=nullptr;auto* a=FindArray(in);if(!a)return E_INVALIDARG;auto* p=CmpSafeArrayCreateVector(a->type,in->rgsabound[0].lLbound,in->rgsabound[0].cElements);if(!p)return E_OUTOFMEMORY;for(ULONG i=0;i<in->rgsabound[0].cElements;++i){LONG index=in->rgsabound[0].lLbound+LONG(i);auto* value=static_cast<BYTE*>(in->pvData)+i*in->cbElements;const auto hr=CmpSafeArrayPutElement(p,&index,a->type==VT_BSTR?static_cast<void*>(*reinterpret_cast<BSTR*>(value)):static_cast<void*>(value));if(FAILED(hr)){CmpSafeArrayDestroy(p);return hr;}}*out=p;return S_OK;}
