extern "C" LPWSTR WINAPI CmpPathFindFileNameW(LPCWSTR path){if(!path)return nullptr;const auto* name=path;for(UINT i=0;path[i]&&i<32768;++i)if(path[i]=='\\'||path[i]=='/'||path[i]==':')name=path+i+1;return const_cast<LPWSTR>(name);}
extern "C" LPWSTR WINAPI CmpPathFindExtensionW(LPCWSTR path){if(!path)return nullptr;auto* name=CmpPathFindFileNameW(path);auto* extension=name+Len(name);for(UINT i=0;name[i];++i)if(name[i]=='.')extension=name+i;return extension;}
extern "C" BOOL WINAPI CmpPathIsRelativeW(LPCWSTR path){return !path||!(path[0]=='\\'||path[0]=='/'||(path[0]&&path[1]==':'));}
extern "C" BOOL WINAPI CmpPathCanonicalizeW(LPWSTR out,LPCWSTR path){if(!out||!path)return FALSE;wchar_t full[128]{};if(!Namespace(path,full))return FALSE;return Text(out,MAX_PATH,full)?TRUE:FALSE;}
extern "C" LPWSTR WINAPI CmpPathCombineW(LPWSTR out,LPCWSTR folder,LPCWSTR file){if(!out)return nullptr;wchar_t input[256]{};if(!file||!file[0]){if(!Text(input,256,folder?folder:L""))return nullptr;}else if(!CmpPathIsRelativeW(file)){if(!Text(input,256,file))return nullptr;}else {if(!Text(input,256,folder?folder:L""))return nullptr;auto at=Len(input);if(at&&input[at-1]!='\\')input[at++]='\\';const auto n=Len(file,256);if(at+n>=256)return nullptr;Copy(input+at,file,(n+1)*2);}return CmpPathCanonicalizeW(out,input)?out:nullptr;}
extern "C" BOOL WINAPI CmpPathAppendW(LPWSTR path,LPCWSTR more){wchar_t out[MAX_PATH]{};return path&&CmpPathCombineW(out,path,more)&&Text(path,MAX_PATH,out)?TRUE:FALSE;}
extern "C" BOOL WINAPI CmpPathRemoveFileSpecW(LPWSTR path){if(!path)return FALSE;const auto n=Len(path,MAX_PATH);if(n>=MAX_PATH)return FALSE;for(UINT i=n;i>0;--i)if(path[i-1]=='\\'||path[i-1]=='/'){if(i==3&&path[1]==':'){path[3]=0;return n>3;}path[i-1]=0;return TRUE;}return FALSE;}
extern "C" LPWSTR WINAPI CmpPathAddBackslashW(LPWSTR path){if(!path)return nullptr;auto n=Len(path,MAX_PATH);if(n>=MAX_PATH-1)return nullptr;if(n&&path[n-1]!='\\')path[n++]='\\';path[n]=0;return path+n;}
extern "C" BOOL WINAPI CmpPathFileExistsW(LPCWSTR path){wchar_t full[128]{};return Namespace(path,full)&&GetFileAttributesW(full)!=INVALID_FILE_ATTRIBUTES;}
extern "C" int WINAPI CmpStrCmpIW(LPCWSTR a,LPCWSTR b){if(!a||!b)return a?1:b?-1:0;for(UINT i=0;i<32768;++i){const auto x=Fold(a[i]),y=Fold(b[i]);if(x!=y)return x<y?-1:1;if(!x)return 0;}return 0;}
extern "C" LPWSTR WINAPI CmpStrStrIW(LPCWSTR text,LPCWSTR match){if(!text||!match)return nullptr;const auto n=Len(match);for(UINT i=0;text[i]||(!i&&!n);++i){UINT j=0;while(j<n&&text[i+j]&&Fold(text[i+j])==Fold(match[j]))++j;if(j==n)return const_cast<LPWSTR>(text+i);}return nullptr;}
