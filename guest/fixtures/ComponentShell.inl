}
extern "C" HRESULT WINAPI CmpSHGetFolderPathW(HWND,int id,HANDLE token,DWORD type,LPWSTR out){if(!out||token||type!=SHGFP_TYPE_CURRENT||(id&~0xFF))return E_INVALIDARG;const auto* folder=GuestFolder(id);return folder&&Text(out,MAX_PATH,folder)?S_OK:E_INVALIDARG;}
extern "C" BOOL WINAPI CmpSHGetSpecialFolderPathW(HWND h,LPWSTR out,int id,BOOL create){return !create&&SUCCEEDED(CmpSHGetFolderPathW(h,id,nullptr,SHGFP_TYPE_CURRENT,out));}
extern "C" HRESULT WINAPI CmpSHGetKnownFolderPath(REFKNOWNFOLDERID id,DWORD flags,HANDLE token,PWSTR* out){if(!out)return E_POINTER;*out=nullptr;if(flags||token)return E_INVALIDARG;int folder=0;if(IsEqualGUID(id,FOLDERID_Profile))folder=CSIDL_PROFILE;else if(IsEqualGUID(id,FOLDERID_Desktop))folder=CSIDL_DESKTOPDIRECTORY;else if(IsEqualGUID(id,FOLDERID_Documents))folder=CSIDL_PERSONAL;else if(IsEqualGUID(id,FOLDERID_RoamingAppData))folder=CSIDL_APPDATA;else if(IsEqualGUID(id,FOLDERID_LocalAppData))folder=CSIDL_LOCAL_APPDATA;else if(IsEqualGUID(id,FOLDERID_Windows))folder=CSIDL_WINDOWS;else if(IsEqualGUID(id,FOLDERID_System))folder=CSIDL_SYSTEM;else if(IsEqualGUID(id,FOLDERID_ProgramFiles))folder=CSIDL_PROGRAM_FILES;else return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);const auto* value=GuestFolder(folder);const auto bytes=(Len(value)+1)*2;*out=static_cast<PWSTR>(CoTaskMemAlloc(bytes));if(!*out)return E_OUTOFMEMORY;Copy(*out,value,bytes);return S_OK;}
extern "C" BOOL WINAPI CmpShellExecuteExW(SHELLEXECUTEINFOW* info){if(!info||info->cbSize!=sizeof(*info)){SetLastError(ERROR_INVALID_PARAMETER);return FALSE;}info->hInstApp=reinterpret_cast<HINSTANCE>(SE_ERR_NOASSOC);info->hProcess=nullptr;if(info->fMask&~(SEE_MASK_NOCLOSEPROCESS|SEE_MASK_FLAG_NO_UI)||info->lpDirectory||(info->lpVerb&&!Same(info->lpVerb,L"open"))){SetLastError(ERROR_NOT_SUPPORTED);return FALSE;}wchar_t path[128]{};if(!Namespace(info->lpFile,path)||!Same(CmpPathFindExtensionW(path),L".exe")){SetLastError(ERROR_NO_ASSOCIATION);return FALSE;}wchar_t command[128]{};auto n=Len(path);if(n+3>=128){SetLastError(ERROR_FILENAME_EXCED_RANGE);return FALSE;}command[0]='"';Copy(command+1,path,n*2);command[++n]='"';++n;if(info->lpParameters&&info->lpParameters[0]){command[n++]=' ';const auto length=Len(info->lpParameters,128);if(n+length>=128){SetLastError(ERROR_FILENAME_EXCED_RANGE);return FALSE;}Copy(command+n,info->lpParameters,(length+1)*2);}STARTUPINFOW startup{};startup.cb=sizeof(startup);PROCESS_INFORMATION child{};if(!CreateProcessW(path,command,nullptr,nullptr,FALSE,0,nullptr,nullptr,&startup,&child)){info->hInstApp=reinterpret_cast<HINSTANCE>(UINT_PTR(GetLastError()==ERROR_FILE_NOT_FOUND?SE_ERR_FNF:SE_ERR_ACCESSDENIED));return FALSE;}CloseHandle(child.hThread);if(info->fMask&SEE_MASK_NOCLOSEPROCESS)info->hProcess=child.hProcess;else CloseHandle(child.hProcess);info->hInstApp=reinterpret_cast<HINSTANCE>(33);return TRUE;}
extern "C" HINSTANCE WINAPI CmpShellExecuteW(HWND h,LPCWSTR verb,LPCWSTR file,LPCWSTR args,LPCWSTR directory,int show){SHELLEXECUTEINFOW info{sizeof(info)};info.hwnd=h;info.lpVerb=verb;info.lpFile=file;info.lpParameters=args;info.lpDirectory=directory;info.nShow=show;CmpShellExecuteExW(&info);return info.hInstApp;}
extern "C" int WINAPI CmpSHFileOperationW(SHFILEOPSTRUCTW* operation){if(!operation)return ERROR_INVALID_PARAMETER;operation->fAnyOperationsAborted=FALSE;if(operation->fFlags&~(FOF_SILENT|FOF_NOCONFIRMATION|FOF_NOERRORUI)||!operation->pFrom||operation->pFrom[Len(operation->pFrom)+1])return ERROR_NOT_SUPPORTED;wchar_t from[128]{},to[128]{};if(!Namespace(operation->pFrom,from))return ERROR_INVALID_NAME;if(operation->wFunc==FO_DELETE)return DeleteFileW(from)?0:int(GetLastError());if((operation->wFunc!=FO_COPY&&operation->wFunc!=FO_MOVE&&operation->wFunc!=FO_RENAME)||!operation->pTo||operation->pTo[Len(operation->pTo)+1]||!Namespace(operation->pTo,to))return ERROR_NOT_SUPPORTED;if(operation->wFunc!=FO_COPY)return MoveFileW(from,to)?0:int(GetLastError());const auto input=CreateFileW(from,GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);if(input==INVALID_HANDLE_VALUE)return int(GetLastError());BYTE bytes[512]{};DWORD read=0;LARGE_INTEGER size{};if(!GetFileSizeEx(input,&size)||size.QuadPart>512||!ReadFile(input,bytes,512,&read,nullptr)){CloseHandle(input);return ERROR_NOT_SUPPORTED;}CloseHandle(input);const auto output=CreateFileW(to,GENERIC_WRITE,0,nullptr,CREATE_NEW,0,nullptr);if(output==INVALID_HANDLE_VALUE)return int(GetLastError());DWORD written=0;const auto okay=WriteFile(output,bytes,read,&written,nullptr)&&written==read;const auto error=okay?0:int(GetLastError());CloseHandle(output);return error;}
