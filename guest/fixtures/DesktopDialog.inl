extern "C" int WINAPI UiMessageBoxW(HWND owner,const wchar_t* text,const wchar_t* caption,UINT type){UiGuard guard;if(type&~(MB_ICONERROR|MB_ICONWARNING|MB_ICONINFORMATION|MB_TOPMOST|MB_SETFOREGROUND|MB_TASKMODAL)||!text)return Fail(ERROR_NOT_SUPPORTED,0);Dialog dialog{};uint32_t count=0;for(;count<511&&text[count];++count)dialog.text[count]=text[count];if(text[count])return Fail(ERROR_INVALID_PARAMETER,0);constexpr wchar_t cls[]=L"Guardian.MessageBox";if(!Lookup(cls,true)){WNDCLASSW c{};c.lpfnWndProc=DialogProc;c.cbWndExtra=0;c.hbrBackground=UiGetSysColorBrush(COLOR_3DFACE);c.lpszClassName=cls;if(!UiRegisterClassW(&c))return 0;}const bool enabled=owner&&UiIsWindowEnabled(owner);if(enabled)UiEnableWindow(owner,FALSE);const auto previous=UiGetForegroundWindow();const auto h=UiCreateWindowExW(WS_EX_TOPMOST,cls,caption?caption:L"MiniNT",WS_POPUP|WS_CAPTION|WS_VISIBLE|WS_SYSMENU,(int(gd::Width)-500)/2,(int(gd::Height)-220)/2,500,220,owner,nullptr,nullptr,&dialog);if(!h){if(enabled)UiEnableWindow(owner,TRUE);return 0;}UiSetForegroundWindow(h);UiUpdateWindow(h);SuspendUi unlock;while(!dialog.done){MSG m{};if(!UiPeekMessageW(&m,nullptr,0,0,PM_REMOVE)){Sleep(1);continue;}if(m.message==WM_QUIT){UiPostQuitMessage(int(m.wParam));dialog.result=IDCANCEL;dialog.done=true;UiDestroyWindow(h);break;}UiTranslateMessage(&m);UiDispatchMessageW(&m);}if(enabled&&UiIsWindow(owner))UiEnableWindow(owner,TRUE);if(previous&&UiIsWindow(previous))UiSetForegroundWindow(previous);return dialog.result;}
