extern "C" BOOL WINAPI UiBitBlt(HDC dc,int x,int y,int width,int height,HDC source,int sx,int sy,DWORD mode){Guard lock;if(mode!=SRCCOPY)return Fail(ERROR_NOT_SUPPORTED,FALSE);g::Call c;c.draw.op=g::Op::BitBlt;c.draw.dc=uint64_t(dc);c.draw.other=uint64_t(source);c.draw.rect={x,y,x+width,y+height};c.draw.source={sx,sy,sx+width,sy+height};return Draw(c)?BOOL(c.graphics.value):FALSE;}
extern "C" int WINAPI UiStretchDIBits(HDC dc,int x,int y,int width,int height,int sx,int sy,int sw,int sh,const void* bits,const BITMAPINFO* info,UINT usage,DWORD mode){Guard lock;if(!bits||!info||usage!=DIB_RGB_COLORS||mode!=SRCCOPY||info->bmiHeader.biSize!=sizeof(BITMAPINFOHEADER)||info->bmiHeader.biPlanes!=1||info->bmiHeader.biBitCount!=32||info->bmiHeader.biCompression||info->bmiHeader.biHeight>=0)return Fail(ERROR_NOT_SUPPORTED,0);auto bitmap=NewBitmap(info->bmiHeader.biWidth,-info->bmiHeader.biHeight,nullptr);if(!bitmap)return 0;auto* b=Bitmap(uint64_t(bitmap));b->bits=const_cast<uint32_t*>(static_cast<const uint32_t*>(bits));b->hash=0;if(!Upload(b)){b->bits=nullptr;UiDeleteObject(bitmap);return 0;}b->bits=nullptr;g::Call c;c.draw.op=g::Op::Stretch;c.draw.dc=uint64_t(dc);c.draw.object=uint64_t(bitmap);c.draw.rect={x,y,x+width,y+height};c.draw.source={sx,sy,sx+sw,sy+sh};const auto ok=Draw(c);UiDeleteObject(bitmap);return ok?int(c.graphics.value):0;}
