extern "C" HGDIOBJ WINAPI UiSelectObject(HDC dc,HGDIOBJ object){Guard lock;auto* local=Dc(dc);if(!local)return Fail(ERROR_INVALID_HANDLE,HGDIOBJ{});if(!Upload(Bitmap(uint64_t(object))))return nullptr;g::Call c;c.draw.op=g::Op::Select;c.draw.dc=uint64_t(dc);c.draw.object=uint64_t(object);if(!Graphics(c))return nullptr;if((uint64_t(object)>>56)==uint32_t(g::Kind::Bitmap))local->bitmap=uint64_t(object);return reinterpret_cast<HGDIOBJ>(c.graphics.value);}
