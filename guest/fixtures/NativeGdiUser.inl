extern "C" HFONT WINAPI UiCreateFontIndirectW(const LOGFONTW* font){Guard lock;if(!font)return Fail(ERROR_INVALID_PARAMETER,HFONT{});g::Call c;c.draw.op=g::Op::Font;static_assert(sizeof(*font)==sizeof(c.draw.font));Copy(&c.draw.font,font,sizeof(*font));return Graphics(c)?reinterpret_cast<HFONT>(c.graphics.value):nullptr;}
extern "C" HFONT WINAPI UiCreateFontW(int height,int width,int esc,int orient,int weight,DWORD italic,DWORD underline,DWORD strike,DWORD charset,DWORD out,DWORD clip,DWORD quality,DWORD pitch,LPCWSTR face){LOGFONTW f{};f.lfHeight=height;f.lfWidth=width;f.lfEscapement=esc;f.lfOrientation=orient;f.lfWeight=weight;f.lfItalic=BYTE(italic);f.lfUnderline=BYTE(underline);f.lfStrikeOut=BYTE(strike);f.lfCharSet=BYTE(charset);f.lfOutPrecision=BYTE(out);f.lfClipPrecision=BYTE(clip);f.lfQuality=BYTE(quality);f.lfPitchAndFamily=BYTE(pitch);if(face){for(int i=0;i<32;++i){f.lfFaceName[i]=face[i];if(!face[i])break;}}return UiCreateFontIndirectW(&f);}
extern "C" HBITMAP WINAPI UiCreateDIBSection(HDC dc,const BITMAPINFO* info,UINT usage,void** bits,HANDLE section,DWORD offset){Guard lock;if(!info||!bits||section||offset||usage!=DIB_RGB_COLORS||info->bmiHeader.biSize!=sizeof(BITMAPINFOHEADER)||info->bmiHeader.biPlanes!=1||info->bmiHeader.biBitCount!=32||info->bmiHeader.biCompression!=BI_RGB||info->bmiHeader.biHeight>=0||(dc&&!Dc(dc)))return Fail(ERROR_NOT_SUPPORTED,HBITMAP{});*bits=nullptr;return NewBitmap(info->bmiHeader.biWidth,-info->bmiHeader.biHeight,bits);}
extern "C" HBITMAP WINAPI UiCreateCompatibleBitmap(HDC dc,int width,int height){Guard lock;if(!Dc(dc))return Fail(ERROR_INVALID_HANDLE,HBITMAP{});return NewBitmap(width,height,nullptr);}
