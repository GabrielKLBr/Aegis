extern "C" HANDLE WINAPI UiLoadImageW(HINSTANCE instance,LPCWSTR name,UINT type,int width,int height,UINT flags){Guard lock;if(instance||!name||uintptr_t(name)<=65535||type!=IMAGE_ICON||flags&~(LR_LOADFROMFILE|LR_DEFAULTSIZE)||!(flags&LR_LOADFROMFILE)||width<0||height<0||width>64||height>64)return Fail(ERROR_NOT_SUPPORTED,HANDLE{});const auto file=CreateFileW(name,GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);if(file==INVALID_HANDLE_VALUE)return nullptr;LARGE_INTEGER size{};if(!GetFileSizeEx(file,&size)||size.QuadPart<6||size.QuadPart>(1<<20)){CloseHandle(file);return Fail(ERROR_INVALID_DATA,HANDLE{});}auto* data=static_cast<BYTE*>(HeapAlloc(GetProcessHeap(),0,SIZE_T(size.QuadPart)));if(!data){CloseHandle(file);return nullptr;}DWORD got=0;const bool read=ReadFile(file,data,DWORD(size.QuadPart),&got,nullptr)!=FALSE;CloseHandle(file);const auto icon=read&&got==size.QuadPart?IconFile(data,got,width?width:32,height?height:32):nullptr;HeapFree(GetProcessHeap(),0,data);return icon;}
