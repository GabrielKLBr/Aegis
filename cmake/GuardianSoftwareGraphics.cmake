    if(dll STREQUAL "d2d1")
        set(software_exports "D2D1CreateFactory=guardian-software-graphics.D2D1CreateFactory\n")
    elseif(dll STREQUAL "dwrite")
        set(software_exports "DWriteCreateFactory=guardian-software-graphics.DWriteCreateFactory\n")
    elseif(dll STREQUAL "d3d11")
        set(software_exports "D3D11CreateDevice=guardian-software-graphics.D3D11CreateDevice\nD3D11CreateDeviceAndSwapChain=guardian-software-graphics.D3D11CreateDeviceAndSwapChain\n")
    elseif(dll STREQUAL "dxgi")
        set(software_exports "CreateDXGIFactory=guardian-software-graphics.CreateDXGIFactory\nCreateDXGIFactory1=guardian-software-graphics.CreateDXGIFactory1\nCreateDXGIFactory2=guardian-software-graphics.CreateDXGIFactory2\n")
    else()
        set(software_exports "Direct3DCreate9=guardian-software-graphics.Direct3DCreate9\nDirect3DCreate9Ex=guardian-software-graphics.Direct3DCreate9Ex\n")
    endif()
    file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/software-generated/${dll}.def" CONTENT "LIBRARY ${dll}\nEXPORTS\n${software_exports}")
    add_library(guardian_software_graphics_${dll} SHARED guest/fixtures/Win32Forward.cpp "${PROJECT_BINARY_DIR}/software-generated/${dll}.def")
    guardian_external_flags(guardian_software_graphics_${dll})
    target_link_libraries(guardian_software_graphics_${dll} PRIVATE guardian_software_graphics_core)
    target_link_options(guardian_software_graphics_${dll} PRIVATE /NOENTRY)
    set_target_properties(guardian_software_graphics_${dll} PROPERTIES OUTPUT_NAME ${dll} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/software-graphics/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/software-graphics-imports/$<CONFIG>")
    add_dependencies(guardian_software_graphics_runtime guardian_software_graphics_${dll})
endforeach()

