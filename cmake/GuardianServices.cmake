if(NOT WIN32 OR NOT TARGET guardian_scanner)
    return()
endif()
if(NOT TARGET scanner_sandbox)
    message(FATAL_ERROR "Windows app engine services require GUARDIAN_BUILD_GUEST_CONTRACT=ON for the MiniNT backend")
endif()
add_library(guardian_engine_client STATIC src/services/Protocol.cpp src/services/Client.cpp)
target_link_libraries(guardian_engine_client PUBLIC scanner_json PRIVATE advapi32 shell32)
target_include_directories(guardian_engine_client PUBLIC "${PROJECT_SOURCE_DIR}/src")
target_compile_definitions(guardian_engine_client PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(guardian_engine_client PRIVATE /W4 /WX /utf-8 /permissive-)
add_executable(guardian-engine-service src/services/Main.cpp src/services/Server.cpp src/services/Installer.cpp
    src/services/Worker.cpp src/EngineFacade.cpp src/SignatureDatabase.cpp src/Util.cpp)
target_link_libraries(guardian-engine-service PRIVATE guardian_engine_client guardian_scanner scanner_sandbox userenv ole32)
target_compile_options(guardian-engine-service PRIVATE /W4 /WX /utf-8 /permissive-)
add_executable(guardian-service-sample test/ServiceSample.cpp)
target_compile_options(guardian-service-sample PRIVATE /GS- /GR- /utf-8)
target_link_options(guardian-service-sample PRIVATE /NODEFAULTLIB /ENTRY:ServiceSampleEntry /MANIFEST:NO /INCREMENTAL:NO)
target_link_libraries(guardian-service-sample PRIVATE kernel32)
set_target_properties(guardian-service-sample PROPERTIES MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE)
add_dependencies(guardian-engine-service guardian-scan-worker guardian-service-sample)
if(TARGET guardian_kernel_audio AND TARGET guardian-desktop)
    target_compile_definitions(guardian_engine_client PUBLIC GUARDIAN_SERVICE_DESKTOP=1)
    add_dependencies(guardian-engine-service guardian-desktop guardian-audio-host guardian_kernel_audio)
    add_custom_command(TARGET guardian-engine-service POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different $<TARGET_FILE:guardian_kernel_audio> "$<TARGET_FILE_DIR:guardian-engine-service>/guardian-kernel-audio.gk" VERBATIM)
    install(FILES $<TARGET_FILE:guardian_kernel_audio> DESTINATION bin RENAME guardian-kernel-audio.gk)
    install(TARGETS guardian-desktop guardian-audio-host RUNTIME DESTINATION bin)
endif()
add_custom_command(TARGET guardian-engine-service POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PROJECT_SOURCE_DIR}/signatures.txt" "$<TARGET_FILE_DIR:guardian-engine-service>/signatures.txt" VERBATIM)
target_link_libraries(avui PRIVATE guardian_engine_client)
target_compile_definitions(avui PRIVATE GUARDIAN_ENGINE_SERVICES=1 NOMINMAX)
add_dependencies(avui guardian-engine-service)
if(TARGET scanner_facade_tests)
    target_link_libraries(scanner_facade_tests PRIVATE guardian_engine_client)
endif()
if(BUILD_TESTING)
    add_executable(engine_services_tests test/EngineServicesTests.cpp)
    target_link_libraries(engine_services_tests PRIVATE guardian_engine_client)
    target_compile_options(engine_services_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME engine_services_protocol COMMAND engine_services_tests)
    set_tests_properties(engine_services_protocol PROPERTIES TIMEOUT 20)
    add_executable(engine_services_facade_tests test/EngineServicesFacadeTests.cpp src/EngineFacade.cpp src/SignatureDatabase.cpp src/Util.cpp)
    target_link_libraries(engine_services_facade_tests PRIVATE guardian_engine_client guardian_scanner)
    target_compile_options(engine_services_facade_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_executable(guardian-service-wait-sample test/ServiceSample.cpp)
    target_compile_definitions(guardian-service-wait-sample PRIVATE AEGIS_SERVICE_WAIT_SAMPLE=1)
    target_compile_options(guardian-service-wait-sample PRIVATE /GS- /GR- /utf-8)
    target_link_options(guardian-service-wait-sample PRIVATE /NODEFAULTLIB /ENTRY:ServiceSampleEntry /MANIFEST:NO /INCREMENTAL:NO)
    target_link_libraries(guardian-service-wait-sample PRIVATE kernel32)
    set_target_properties(guardian-service-wait-sample PROPERTIES MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE)
endif()
install(TARGETS guardian-engine-service guardian-service-sample avui RUNTIME DESTINATION bin)
