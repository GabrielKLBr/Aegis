option(GUARDIAN_BUILD_WINDOW_BRIDGE "Build phase 12F native window presentation" ${GUARDIAN_BUILD_INTERNET})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_WINDOW_BRIDGE OR NOT TARGET guardian_kernel_internet)
    return()
endif()
add_executable(guardian_kernel_integrated)
get_target_property(window_kernel_sources guardian_kernel_internet SOURCES)
target_sources(guardian_kernel_integrated PRIVATE ${window_kernel_sources} guest/DesktopWindowInput.cpp)
target_link_libraries(guardian_kernel_integrated PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_internet ${property})
    set_property(TARGET guardian_kernel_integrated PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_integrated PRIVATE GUARDIAN_WINDOW_BRIDGE=1)
set_target_properties(guardian_kernel_integrated PROPERTIES OUTPUT_NAME guardian-kernel-integrated SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_integrated guardian_kernel_internet)
add_custom_command(TARGET guardian_kernel_integrated POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_integrated> VERBATIM)
add_custom_target(guardian_window_bridge DEPENDS guardian_kernel_integrated guardian_internet guardian_components)
if(BUILD_TESTING)
    add_executable(window_bridge_core_tests test/WindowBridgeCoreTests.cpp guest/DesktopWindowInput.cpp guest/Desktop.cpp guest/DesktopRaster.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp src/microvm/gui/WindowBridge.cpp src/microvm/state/Files.cpp src/microvm/state/StorageBudget.cpp)
    target_link_libraries(window_bridge_core_tests PRIVATE guardian_abi bcrypt)
    target_compile_definitions(window_bridge_core_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
    target_compile_options(window_bridge_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME window_bridge_core COMMAND window_bridge_core_tests)
    add_executable(window_bridge_native_tests test/WindowBridgeNativeTests.cpp src/microvm/gui/WindowPresenter.cpp)
    target_link_libraries(window_bridge_native_tests PRIVATE guardian_boot_core user32 gdi32)
    target_compile_definitions(window_bridge_native_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN WINDOW_BRIDGE_TESTING=1)
    target_compile_options(window_bridge_native_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME window_bridge_native COMMAND window_bridge_native_tests)
    set_tests_properties(window_bridge_native PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
    add_dependencies(guardian_window_bridge window_bridge_core_tests window_bridge_native_tests)
endif()

foreach(application IN ITEMS demo crash hang)
    add_executable(guardian_integrated_${application} guest/fixtures/IntegratedWindows.cpp)
    target_compile_options(guardian_integrated_${application} PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(guardian_integrated_${application} PRIVATE user32 gdi32)
    target_link_options(guardian_integrated_${application} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_integrated_${application} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-integrated-${application} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/integrated/$<CONFIG>")
    if(application STREQUAL "crash")
        target_compile_definitions(guardian_integrated_${application} PRIVATE INTEGRATED_MODE=1)
    elseif(application STREQUAL "hang")
        target_compile_definitions(guardian_integrated_${application} PRIVATE INTEGRATED_MODE=2)
    endif()
    add_dependencies(guardian_window_bridge guardian_integrated_${application})
endforeach()

if(BUILD_TESTING)
    foreach(scenario IN ITEMS programs components)
        add_test(NAME window_bridge_${scenario}_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/WindowBridgeIntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}" --evidence "${PROJECT_BINARY_DIR}/window-bridge-${scenario}-$<CONFIG>" --case ${scenario})
        set_tests_properties(window_bridge_${scenario}_integration PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    endforeach()
    if(GUARDIAN_DESKTOP_FLAPPY_EXE)
        add_test(NAME window_bridge_flappy_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/WindowBridgeIntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}" --application "${GUARDIAN_DESKTOP_FLAPPY_EXE}" --evidence "${PROJECT_BINARY_DIR}/window-bridge-flappy-$<CONFIG>" --case flappy)
        set_tests_properties(window_bridge_flappy_integration PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    endif()
    add_test(NAME window_bridge_runtime_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/WindowBridgeRuntimeToolsTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}")
    set_tests_properties(window_bridge_runtime_tools PROPERTIES TIMEOUT 60)
endif()
