target_compile_options(guardian_whp_memory PRIVATE /W4 /WX /utf-8 /permissive-)
set(guardian_vmm_targets)
foreach(guardian_target IN LISTS guardian_existing_targets)
    get_target_property(guardian_sources "${guardian_target}" SOURCES)
    if(guardian_sources MATCHES "MicroVmMonitor\\.cpp")
        add_dependencies(${guardian_target} guardian_whp_memory)
    endif()
    get_target_property(guardian_type "${guardian_target}" TYPE)
    if(guardian_type STREQUAL "EXECUTABLE" AND guardian_target MATCHES "^(vm|microsandbox)")
        list(APPEND guardian_vmm_targets "${guardian_target}")
    endif()
endforeach()
add_custom_target(guardian_host DEPENDS av avui)
