# Explicit build boundaries; existing sources stay in their current locations.
add_library(guardian_abi INTERFACE)
target_include_directories(guardian_abi INTERFACE "${PROJECT_SOURCE_DIR}/shared")
target_compile_features(guardian_abi INTERFACE cxx_std_20)

get_property(guardian_existing_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
add_executable(guardian_whp_memory src/microvm/vmm/MemoryHost.cpp)
