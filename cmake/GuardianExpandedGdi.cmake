set(GUARDIAN_EXPANDED_GDI_CORPUS "" CACHE PATH "Local independent Petzold GDI sources; never redistributed")
if(BUILD_TESTING AND EXISTS "${GUARDIAN_EXPANDED_GDI_CORPUS}/bezier.c" AND EXISTS "${GUARDIAN_EXPANDED_GDI_CORPUS}/clover.c" AND EXISTS "${GUARDIAN_EXPANDED_GDI_CORPUS}/whatsize.c")
    foreach(app IN ITEMS bezier clover whatsize)
        foreach(variant IN ITEMS Unicode ANSI)
            set(suffix "")
            if(variant STREQUAL "ANSI")
                set(suffix "_a")
            endif()
            set(target expanded_external_${app}${suffix})
            add_executable(${target} WIN32 "${GUARDIAN_EXPANDED_GDI_CORPUS}/${app}.c")
            if(variant STREQUAL "Unicode")
                target_compile_definitions(${target} PRIVATE UNICODE _UNICODE)
            endif()
            target_compile_options(${target} PRIVATE /W3 /utf-8)
            target_link_libraries(${target} PRIVATE user32 gdi32)
            target_link_options(${target} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
            set_target_properties(${target} PROPERTIES OUTPUT_NAME ${app}${suffix} MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/external/gdi/$<CONFIG>")
            add_custom_command(TARGET ${target} POST_BUILD COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/tools/gdi_corpus.py" --source "${GUARDIAN_EXPANDED_GDI_CORPUS}/${app}.c" --binary $<TARGET_FILE:${target}> --application ${app} --variant ${variant} VERBATIM)
            add_dependencies(guardian_expanded_gdi_runtime ${target})
        endforeach()
    endforeach()
endif()



