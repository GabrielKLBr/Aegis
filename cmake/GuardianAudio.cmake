option(GUARDIAN_BUILD_AUDIO "Build phase 14.10G bounded PCM playback" ${GUARDIAN_BUILD_SOFTWARE_GRAPHICS})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_AUDIO OR NOT TARGET guardian_software_graphics_runtime)
    return()
endif()
set(audio_definitions ${software_definitions} GUARDIAN_AUDIO=1)
# Recompile the GUI adapters with protocol 7; never reuse a protocol 6 DLL
# behind a protocol 7 manifest. The F targets keep their original definitions.
foreach(part IN ITEMS gateway user32 core combase windowscodecs gdi32 comdlg32 comctl32 dwmapi d2d1 dwrite d3d11 dxgi d3d9)
    set(old guardian_software_graphics_${part})
    set(new guardian_audio_${part})
    get_target_property(sources ${old} SOURCES)
    add_library(${new} SHARED ${sources})
    foreach(prop IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS LINK_LIBRARIES MSVC_RUNTIME_LIBRARY MSVC_RUNTIME_CHECKS VS_JUST_MY_CODE_DEBUGGING)
        get_target_property(value ${old} ${prop})
        if(NOT value STREQUAL "value-NOTFOUND")
            string(REPLACE "guardian_software_graphics_" "guardian_audio_" value "${value}")
            set_property(TARGET ${new} PROPERTY ${prop} "${value}")
        endif()
    endforeach()
    target_compile_definitions(${new} PRIVATE GUARDIAN_AUDIO=1)
    get_target_property(output ${old} OUTPUT_NAME)
    set_target_properties(${new} PROPERTIES OUTPUT_NAME ${output} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/audio/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/audio-imports/$<CONFIG>")
endforeach()
