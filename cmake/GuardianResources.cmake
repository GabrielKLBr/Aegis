if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(guardian_resources_core guardian_boot_core)
else()
    set(guardian_resources_core guardian_kvm)
endif()
target_sources(${guardian_resources_core} PRIVATE src/microvm/state/Resources.cpp src/microvm/boot/StorageSpace.cpp src/microvm/state/StorageBudget.cpp src/microvm/state/SnapshotDisk.cpp)
if(WIN32 AND TARGET guest_storage_host_tests)
    target_sources(guest_storage_host_tests PRIVATE src/microvm/boot/StorageSpace.cpp src/microvm/state/StorageBudget.cpp src/microvm/state/Files.cpp)
endif()
if(BUILD_TESTING)
    add_executable(resource_tests test/ResourceTests.cpp)
    target_link_libraries(resource_tests PRIVATE ${guardian_resources_core})
    if(WIN32)
        target_sources(resource_tests PRIVATE guest/Volume.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    else()
        target_link_libraries(resource_tests PRIVATE guardian_guest_core)
    endif()
    if(MSVC)
        target_compile_definitions(resource_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(resource_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    else()
        target_compile_options(resource_tests PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME resource_budgets COMMAND resource_tests "${PROJECT_BINARY_DIR}/resource-budgets-$<CONFIG>")
    set_tests_properties(resource_budgets PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE)
    if(WIN32)
        set(resource_kernel $<TARGET_FILE:guardian_kernel>)
    elseif(GUARDIAN_TEST_KVM)
        set(resource_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel.gk")
    endif()
    if(WIN32 OR GUARDIAN_TEST_KVM)
        add_test(NAME resource_manager COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/test_resources.py"
            $<TARGET_FILE:guardian-vm> "${resource_kernel}" "${PROJECT_BINARY_DIR}/resource-manager-$<CONFIG>")
        set_tests_properties(resource_manager PROPERTIES TIMEOUT 300 RUN_SERIAL TRUE)
        add_executable(resource_snapshot_tests test/ResourceSnapshotTests.cpp)
        target_link_libraries(resource_snapshot_tests PRIVATE ${guardian_resources_core})
        if(MSVC)
            target_compile_definitions(resource_snapshot_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_compile_options(resource_snapshot_tests PRIVATE /W4 /WX /utf-8 /permissive-)
            add_dependencies(resource_snapshot_tests guardian_kernel_storage)
            set(resource_storage_kernel $<TARGET_FILE:guardian_kernel_storage>)
        else()
            target_compile_options(resource_snapshot_tests PRIVATE -Wall -Wextra -Werror)
            set(resource_storage_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-storage.gk")
        endif()
        set(GUARDIAN_LEGACY_STORAGE_KERNEL "" CACHE FILEPATH "Optional pre-quota owned storage kernel for compatibility regression")
        add_test(NAME resource_snapshot COMMAND resource_snapshot_tests "${resource_storage_kernel}"
            "${PROJECT_BINARY_DIR}/resource-snapshot-$<CONFIG>" ${GUARDIAN_LEGACY_STORAGE_KERNEL})
        set_tests_properties(resource_snapshot PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    endif()
endif()

include("${PROJECT_SOURCE_DIR}/cmake/GuardianScalable.cmake")
