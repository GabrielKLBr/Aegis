option(GUARDIAN_BUILD_COMPONENTS "Build phase 14.8 guest components" ${GUARDIAN_BUILD_DESKTOP})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_COMPONENTS OR NOT TARGET guardian_kernel_desktop)
    return()
endif()
set(component_generated "${PROJECT_BINARY_DIR}/component-generated")
set(component_dlls combase ole32 oleaut32 rpcrt4 propsys shell32 shlwapi comctl32 comdlg32 uxtheme)
set(component_definitions)
foreach(dll IN LISTS component_dlls)
    list(APPEND component_definitions "${component_generated}/${dll}.def")
endforeach()
file(GLOB component_sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/guest/fixtures/Component*.cpp" "${PROJECT_SOURCE_DIR}/guest/fixtures/Component*.inl")
add_custom_command(OUTPUT ${component_definitions} "${component_generated}/coverage.json"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/component_runtime.py" exports "${component_generated}"
    DEPENDS tools/component_runtime.py ${component_sources} VERBATIM)
add_library(guardian_component_combase SHARED guest/fixtures/ComponentCom.cpp guest/fixtures/ComponentProperties.cpp guest/fixtures/ComponentCall.asm guest/Memory.cpp guest/StackProbe.asm "${component_generated}/combase.def")
guardian_external_flags(guardian_component_combase)
target_link_libraries(guardian_component_combase PRIVATE guardian_desktop_kernel32 guardian_security_advapi32 uuid)
target_link_options(guardian_component_combase PRIVATE /ENTRY:ComponentEntry /EXPORT:GuardianComponentCall)
add_library(guardian_component_shell32 SHARED guest/fixtures/ComponentDesktop.cpp guest/Memory.cpp guest/StackProbe.asm "${component_generated}/shell32.def")
guardian_external_flags(guardian_component_shell32)
target_link_libraries(guardian_component_shell32 PRIVATE guardian_desktop_kernel32 guardian_desktop_user32 guardian_desktop_gdi32 guardian_component_combase uuid)
target_link_options(guardian_component_shell32 PRIVATE /ENTRY:ComponentDesktopEntry)
foreach(dll IN LISTS component_dlls)
    if(NOT dll STREQUAL "combase" AND NOT dll STREQUAL "shell32")
        add_library(guardian_component_${dll} SHARED guest/fixtures/Win32Forward.cpp "${component_generated}/${dll}.def")
        guardian_external_flags(guardian_component_${dll})
        target_link_options(guardian_component_${dll} PRIVATE /NOENTRY)
        if(dll MATCHES "^(ole32|oleaut32|rpcrt4|propsys)$")
            target_link_libraries(guardian_component_${dll} PRIVATE guardian_component_combase)
        else()
            target_link_libraries(guardian_component_${dll} PRIVATE guardian_component_shell32)
        endif()
        add_dependencies(guardian_component_${dll} guardian_component_combase guardian_component_shell32)
    endif()
    set_target_properties(guardian_component_${dll} PROPERTIES OUTPUT_NAME ${dll} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/components/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/components-imports/$<CONFIG>")
endforeach()
add_executable(guardian_kernel_components)
get_target_property(component_kernel_sources guardian_kernel_desktop SOURCES)
target_sources(guardian_kernel_components PRIVATE ${component_kernel_sources} guest/Component.cpp)
target_link_libraries(guardian_kernel_components PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_desktop ${property})
    set_property(TARGET guardian_kernel_components PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_components PRIVATE GUARDIAN_COMPONENT_NATIVE=1)
set_target_properties(guardian_kernel_components PROPERTIES OUTPUT_NAME guardian-kernel-components SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_components guardian_kernel_desktop)
add_custom_command(TARGET guardian_kernel_components POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_components> VERBATIM)

# These executables use ordinary Windows SDK imports, independent of the owned import libraries.
foreach(application IN ITEMS client controls rpc child)
    if(application STREQUAL "client")
        set(source guest/fixtures/ComponentClient.cpp)
        set(libraries ole32 oleaut32 propsys advapi32 uuid)
    elseif(application STREQUAL "controls")
        set(source guest/fixtures/ComponentControls.cpp)
        set(libraries kernel32 user32 gdi32 comctl32 comdlg32 shell32 shlwapi uxtheme ole32 uuid)
    elseif(application STREQUAL "rpc")
        set(source guest/fixtures/ComponentRpcProbe.cpp)
        set(libraries rpcrt4)
    else()
        set(source guest/fixtures/ComponentChild.cpp)
        set(libraries kernel32)
    endif()
    add_executable(guardian_component_${application} ${source})
    target_compile_options(guardian_component_${application} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_link_libraries(guardian_component_${application} PRIVATE ${libraries})
    target_link_options(guardian_component_${application} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_component_${application} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-component-${application} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/components/$<CONFIG>")
    if(BUILD_TESTING AND NOT application STREQUAL "child")
        add_executable(component_windows_${application} ${source})
        if(application STREQUAL "controls")
            target_sources(component_windows_controls PRIVATE guest/fixtures/ComponentControls.manifest)
        endif()
        target_compile_definitions(component_windows_${application} PRIVATE COMPONENT_REFERENCE=1)
        target_compile_options(component_windows_${application} PRIVATE /W4 /WX /utf-8 /permissive-)
        target_link_libraries(component_windows_${application} PRIVATE ${libraries})
        add_test(NAME component_windows_${application} COMMAND component_windows_${application})
    endif()
endforeach()
foreach(kind IN ITEMS inproc server)
    if(kind STREQUAL "inproc")
        add_library(guardian_component_inproc SHARED guest/fixtures/ComponentServer.cpp)
        target_link_options(guardian_component_inproc PRIVATE /EXPORT:DllGetClassObject=ComponentGetClassObject /EXPORT:DllCanUnloadNow=ComponentCanUnloadNow)
    else()
        add_executable(guardian_component_server guest/fixtures/ComponentServer.cpp)
        target_compile_definitions(guardian_component_server PRIVATE COMPONENT_SERVER_EXE=1)
    endif()
    target_compile_options(guardian_component_${kind} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_link_libraries(guardian_component_${kind} PRIVATE ole32 oleaut32 uuid)
    target_link_options(guardian_component_${kind} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_component_${kind} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-component-${kind} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/components/$<CONFIG>")
endforeach()
if(BUILD_TESTING)
    add_executable(component_core_tests test/ComponentCoreTests.cpp guest/Component.cpp guest/Volume.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    target_link_libraries(component_core_tests PRIVATE guardian_abi)
    target_compile_options(component_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    target_compile_definitions(component_core_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
    add_test(NAME component_core COMMAND component_core_tests)
endif()
add_custom_target(guardian_components)
foreach(variant IN ITEMS client-crash client-timeout client-persist controls-cancel)
    if(variant MATCHES "^client")
        set(source guest/fixtures/ComponentClient.cpp)
        set(libraries ole32 oleaut32 propsys advapi32 uuid)
    else()
        set(source guest/fixtures/ComponentControls.cpp)
        set(libraries kernel32 user32 gdi32 comctl32 comdlg32 shell32 shlwapi uxtheme ole32 uuid)
    endif()
    add_executable(guardian_component_${variant} ${source})
    target_compile_options(guardian_component_${variant} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_link_libraries(guardian_component_${variant} PRIVATE ${libraries})
    if(variant STREQUAL "client-persist")
        target_compile_definitions(guardian_component_${variant} PRIVATE COMPONENT_TEST_MODE=3)
    elseif(variant STREQUAL "client-timeout")
        target_compile_definitions(guardian_component_${variant} PRIVATE COMPONENT_TEST_MODE=2)
    else()
        target_compile_definitions(guardian_component_${variant} PRIVATE COMPONENT_TEST_MODE=1)
    endif()
    target_link_options(guardian_component_${variant} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_component_${variant} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-component-${variant} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/components/$<CONFIG>")
    add_dependencies(guardian_components guardian_component_${variant})
endforeach()
if(BUILD_TESTING)
    foreach(scenario IN ITEMS com rpc controls)
        add_test(NAME component_${scenario}_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/ComponentIntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}" --evidence "${PROJECT_BINARY_DIR}/components-${scenario}-$<CONFIG>" --case ${scenario})
        set_tests_properties(component_${scenario}_integration PROPERTIES TIMEOUT 240 RUN_SERIAL TRUE)
    endforeach()
    add_test(NAME component_runtime_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/ComponentRuntimeToolsTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}")
endif()
foreach(dll IN LISTS component_dlls)
    add_dependencies(guardian_components guardian_component_${dll})
endforeach()
foreach(application IN ITEMS client controls rpc child inproc server)
    add_dependencies(guardian_components guardian_component_${application})
endforeach()
add_dependencies(guardian_components guardian_kernel_components guardian-desktop)
if(BUILD_TESTING)
    add_dependencies(guardian_components component_core_tests component_windows_client component_windows_controls component_windows_rpc)
endif()
