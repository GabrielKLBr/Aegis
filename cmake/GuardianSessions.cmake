# Phase 12D: bounded long sessions with real time and guest-only interaction.
if(NOT BUILD_TESTING)
    return()
endif()
if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(session_core guardian_boot_core)
else()
    set(session_core guardian_kvm)
endif()
add_executable(session_core_tests test/SessionCoreTests.cpp)
target_link_libraries(session_core_tests PRIVATE ${session_core})
add_test(NAME session_core COMMAND session_core_tests "${PROJECT_BINARY_DIR}/session-core-$<CONFIG>")
set_tests_properties(session_core PROPERTIES TIMEOUT 30)
if(WIN32 OR GUARDIAN_TEST_KVM)
    add_executable(session_wait_tests test/SessionWaitTests.cpp)
    target_link_libraries(session_wait_tests PRIVATE ${session_core})
    if(WIN32)
        set(session_image $<TARGET_FILE:guardian_kernel_session>)
        set(session_graphics $<TARGET_FILE:guardian_kernel_graphics>)
        add_dependencies(session_wait_tests guardian_kernel_session)
    else()
        set(session_image "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-session.gk")
        set(session_graphics "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-graphics.gk")
    endif()
    add_test(NAME session_wait COMMAND session_wait_tests "${session_image}" "${PROJECT_BINARY_DIR}/session-wait-$<CONFIG>")
    set_tests_properties(session_wait PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE)
    add_test(NAME session_lifecycle COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/SessionLifecycleTests.py"
        $<TARGET_FILE:guardian-vm> $<TARGET_FILE:guardian-gui> "${session_graphics}" "${session_image}" "${PROJECT_BINARY_DIR}/session-lifecycle-$<CONFIG>")
    set_tests_properties(session_lifecycle PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
endif()
foreach(session_target IN ITEMS session_core_tests session_wait_tests)
    if(TARGET ${session_target})
        if(MSVC)
            target_compile_definitions(${session_target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_compile_options(${session_target} PRIVATE /W4 /WX /utf-8 /permissive-)
        else()
            target_compile_options(${session_target} PRIVATE -Wall -Wextra -Werror)
        endif()
    endif()
endforeach()
if(WIN32 AND TARGET guardian_reference)
    add_dependencies(guardian_reference session_core_tests session_wait_tests)
endif()
