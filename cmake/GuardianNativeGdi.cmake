    target_link_libraries(guardian_native_gdi_${mode} PRIVATE guardian_abi guardian_native_gdi_user32 guardian_native_gdi_gdi32)
    target_link_options(guardian_native_gdi_${mode} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_native_gdi_${mode} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-native-gdi-${mode} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-gdi/$<CONFIG>")
    if(mode STREQUAL "crash")
        target_compile_definitions(guardian_native_gdi_${mode} PRIVATE NATIVE_GDI_MODE=1)
    elseif(mode STREQUAL "hang")
        target_compile_definitions(guardian_native_gdi_${mode} PRIVATE NATIVE_GDI_MODE=2)
    elseif(mode STREQUAL "input")
        target_compile_definitions(guardian_native_gdi_${mode} PRIVATE NATIVE_GDI_MODE=3)
    else()
        target_compile_definitions(guardian_native_gdi_${mode} PRIVATE NATIVE_GDI_MODE=0)
    endif()
    add_dependencies(guardian_native_gdi_runtime guardian_native_gdi_${mode})
endforeach()

