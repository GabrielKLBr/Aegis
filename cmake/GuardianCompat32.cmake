option(GUARDIAN_BUILD_COMPAT32 "Build the bounded PE32 compatibility runtime" ${GUARDIAN_BUILD_NATIVE_USER32})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_COMPAT32 OR NOT TARGET guardian_kernel_native_user32)
    return()
endif()
add_executable(guardian_kernel_compat32)
get_target_property(compat_sources guardian_kernel_native_user32 SOURCES)
target_sources(guardian_kernel_compat32 PRIVATE ${compat_sources})
target_link_libraries(guardian_kernel_compat32 PRIVATE guardian_abi)
foreach(prop IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_native_user32 ${prop})
    set_property(TARGET guardian_kernel_compat32 PROPERTY ${prop} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_compat32 PRIVATE GUARDIAN_COMPAT32=1)
set_target_properties(guardian_kernel_compat32 PROPERTIES OUTPUT_NAME guardian-kernel-compat32 SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_custom_command(TARGET guardian_kernel_compat32 POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_compat32> VERBATIM)
add_custom_target(guardian_compat32_runtime
    COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/tools/build_compat32.py" --output "${PROJECT_BINARY_DIR}/guest/compat32/$<CONFIG>" --config "$<CONFIG>"
    DEPENDS guardian_kernel_compat32 guardian-native-user-host guardian-desktop guardian_whp_memory VERBATIM)
add_executable(guardian-compat32-tests test/Compat32LoaderTests.cpp guest/PeLoader.cpp)
target_link_libraries(guardian-compat32-tests PRIVATE guardian_abi)
target_compile_definitions(guardian-compat32-tests PRIVATE GUARDIAN_SCALABLE_PE=1 GUARDIAN_COMPAT32=1)
target_compile_options(guardian-compat32-tests PRIVATE /W4 /WX /utf-8 /EHsc /fsanitize=address /Zi)
target_link_options(guardian-compat32-tests PRIVATE /INCREMENTAL:NO /DEBUG)
set_target_properties(guardian-compat32-tests PROPERTIES MSVC_RUNTIME_CHECKS "" VS_JUST_MY_CODE_DEBUGGING FALSE)
