target_sources(guardian_kernel_native_user32 PRIVATE ${native_user_sources})
target_link_libraries(guardian_kernel_native_user32 PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_integrated ${property})
    set_property(TARGET guardian_kernel_native_user32 PROPERTY ${property} "${value}")
endforeach()
