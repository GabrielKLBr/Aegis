foreach(mode IN ITEMS demo crash hang input threads)
    if(mode STREQUAL "threads")
        set(source guest/fixtures/NativeUserThreads.cpp)
    else()
        set(source guest/fixtures/NativeUserDemo.cpp)
    endif()
    add_executable(guardian_native_user_${mode} ${source})
    target_compile_options(guardian_native_user_${mode} PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(guardian_native_user_${mode} PRIVATE guardian_abi guardian_native_user32)
    target_link_options(guardian_native_user_${mode} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_native_user_${mode} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-native-user-${mode} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-user32/$<CONFIG>")
    if(mode STREQUAL "crash")
        target_compile_definitions(guardian_native_user_${mode} PRIVATE NATIVE_USER_MODE=1)
    elseif(mode STREQUAL "hang")
        target_compile_definitions(guardian_native_user_${mode} PRIVATE NATIVE_USER_MODE=2)
    elseif(mode STREQUAL "input")
        target_compile_definitions(guardian_native_user_${mode} PRIVATE NATIVE_USER_MODE=3)
    else()
        target_compile_definitions(guardian_native_user_${mode} PRIVATE NATIVE_USER_MODE=0)
    endif()
    add_dependencies(guardian_native_user32_runtime guardian_native_user_${mode})
endforeach()
