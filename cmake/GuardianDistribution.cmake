if(NOT WIN32 OR NOT TARGET scanner_json)
    return()
endif()
# Sources compile with each consumer's CRT: the portable bootstrap uses /MT,
# whereas existing services and the WinUI client use /MD.
add_library(guardian_distribution INTERFACE)
target_sources(guardian_distribution INTERFACE "${PROJECT_SOURCE_DIR}/src/distribution/Trust.cpp" "${PROJECT_SOURCE_DIR}/src/distribution/Transactions.cpp" "${PROJECT_SOURCE_DIR}/src/distribution/Prerequisites.cpp")
target_include_directories(guardian_distribution INTERFACE "${PROJECT_SOURCE_DIR}/src")
target_link_libraries(guardian_distribution INTERFACE scanner_json bcrypt advapi32)
target_compile_definitions(guardian_distribution INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
add_executable(guardian-publisher src/distribution/Publisher.cpp)
target_link_libraries(guardian-publisher PRIVATE guardian_distribution ncrypt)
add_executable(guardian-distribution src/distribution/Main.cpp)
target_link_libraries(guardian-distribution PRIVATE guardian_distribution)
foreach(target guardian-publisher guardian-distribution)
    target_compile_options(${target} PRIVATE /W4 /WX /utf-8 /permissive-)
    set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
endforeach()
if(BUILD_TESTING)
    add_executable(distribution_tests test/DistributionTests.cpp)
    target_link_libraries(distribution_tests PRIVATE guardian_distribution scanner_sqlite ncrypt)
    target_compile_definitions(distribution_tests PRIVATE AEGIS_DISTRIBUTION_TESTING=1)
    target_compile_options(distribution_tests PRIVATE /W4 /WX /utf-8 /permissive-)
endif()
