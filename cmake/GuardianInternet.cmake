option(GUARDIAN_BUILD_INTERNET "Build phase 14.9 network and cryptographic contracts" ${GUARDIAN_BUILD_COMPONENTS})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_INTERNET OR NOT TARGET guardian_kernel_components)
    return()
endif()
enable_language(C)
target_link_libraries(guardian_boot_core PUBLIC ws2_32 bcrypt)
file(GLOB_RECURSE bearssl_sources CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/guest/third_party/bearssl/src/*.c")
add_library(guardian_bearssl STATIC ${bearssl_sources})
target_include_directories(guardian_bearssl PUBLIC "${PROJECT_SOURCE_DIR}/guest/third_party/bearssl/inc" PRIVATE "${PROJECT_SOURCE_DIR}/guest/third_party/bearssl/src")
target_compile_definitions(guardian_bearssl PRIVATE BR_64=1 BR_INT128=0 BR_UMUL128=0 BR_AES_X86NI=0 BR_POWER8=0 BR_SSE2=0 BR_RDRAND=0 BR_USE_WIN32_RAND=0 BR_USE_WIN32_TIME=0 BR_USE_UNIX_TIME=0 BR_USE_URANDOM=0 BR_USE_GETENTROPY=0 _CRT_SECURE_NO_WARNINGS)
target_compile_options(guardian_bearssl PRIVATE /W0 /O2 /Ob2 /Oi /GS- /Zl /JMC-)
set_target_properties(guardian_bearssl PROPERTIES MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_executable(guardian_kernel_internet)
get_target_property(internet_kernel_sources guardian_kernel_components SOURCES)
target_sources(guardian_kernel_internet PRIVATE ${internet_kernel_sources})
target_link_libraries(guardian_kernel_internet PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_components ${property})
    set_property(TARGET guardian_kernel_internet PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_internet PRIVATE GUARDIAN_INTERNET_NATIVE=1)
set_target_properties(guardian_kernel_internet PROPERTIES OUTPUT_NAME guardian-kernel-internet SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_internet guardian_kernel_components)
add_custom_command(TARGET guardian_kernel_internet POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_internet> VERBATIM)
set(internet_generated "${PROJECT_BINARY_DIR}/internet-generated")
set(internet_dlls ws2_32 mswsock dnsapi iphlpapi winhttp wininet bcrypt ncrypt crypt32 secur32)
set(internet_definitions "${internet_generated}/guardianinet.def")
foreach(dll IN LISTS internet_dlls)
    list(APPEND internet_definitions "${internet_generated}/${dll}.def")
endforeach()
add_custom_command(OUTPUT ${internet_definitions} "${internet_generated}/coverage.json" COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/internet_runtime.py" exports "${internet_generated}" DEPENDS tools/internet_runtime.py config/internet-ordinals.json VERBATIM)
add_library(guardian_internet_core SHARED guest/fixtures/InternetBase.cpp guest/fixtures/InternetSockets.cpp guest/fixtures/InternetCrypto.cpp guest/fixtures/InternetCertificates.cpp guest/fixtures/InternetTls.cpp guest/fixtures/InternetHttp.cpp guest/fixtures/InternetWininet.cpp guest/fixtures/InternetCall.asm guest/Memory.cpp guest/StackProbe.asm "${internet_generated}/guardianinet.def")
guardian_external_flags(guardian_internet_core)
target_link_libraries(guardian_internet_core PRIVATE guardian_desktop_kernel32 guardian_security_advapi32 guardian_bearssl)
target_link_options(guardian_internet_core PRIVATE /ENTRY:InternetEntry)
set_target_properties(guardian_internet_core PROPERTIES OUTPUT_NAME guardianinet RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet-imports/$<CONFIG>")
foreach(dll IN LISTS internet_dlls)
    add_library(guardian_internet_${dll} SHARED guest/fixtures/Win32Forward.cpp "${internet_generated}/${dll}.def")
    guardian_external_flags(guardian_internet_${dll})
    target_link_options(guardian_internet_${dll} PRIVATE /NOENTRY)
    target_link_libraries(guardian_internet_${dll} PRIVATE guardian_internet_core)
    add_dependencies(guardian_internet_${dll} guardian_internet_core)
    set_target_properties(guardian_internet_${dll} PROPERTIES OUTPUT_NAME ${dll} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet-imports/$<CONFIG>")
endforeach()
add_custom_target(guardian_internet DEPENDS guardian_kernel_internet guardian_internet_core guardian-desktop)
foreach(dll IN LISTS internet_dlls)
    add_dependencies(guardian_internet guardian_internet_${dll})
endforeach()
foreach(application IN ITEMS crypto persist)
    add_executable(guardian_internet_${application} guest/fixtures/InternetCryptoProbe.cpp)
    target_compile_options(guardian_internet_${application} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_link_libraries(guardian_internet_${application} PRIVATE bcrypt ncrypt)
    target_link_options(guardian_internet_${application} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_internet_${application} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-internet-${application} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet/$<CONFIG>")
    if(application STREQUAL "persist")
        target_compile_definitions(guardian_internet_${application} PRIVATE INTERNET_PERSIST_ONLY=1)
    endif()
    add_dependencies(guardian_internet guardian_internet_${application})
endforeach()
if(BUILD_TESTING)
    add_executable(internet_crypto_reference guest/fixtures/InternetCryptoProbe.cpp)
    target_compile_definitions(internet_crypto_reference PRIVATE INTERNET_REFERENCE=1)
    target_compile_options(internet_crypto_reference PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(internet_crypto_reference PRIVATE bcrypt ncrypt)
    add_test(NAME internet_crypto_reference COMMAND internet_crypto_reference)
    add_executable(internet_core_tests test/InternetBackendTests.cpp)
    target_compile_options(internet_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(internet_core_tests PRIVATE guardian_boot_core)
    add_test(NAME internet_core COMMAND internet_core_tests)
    add_dependencies(guardian_internet internet_crypto_reference internet_core_tests)
endif()
set(internet_mode 0)
foreach(application IN ITEMS sockets http async timeout tls sspi offline simulated)
    add_executable(guardian_internet_${application} guest/fixtures/InternetClientProbe.cpp)
    target_compile_definitions(guardian_internet_${application} PRIVATE INTERNET_CLIENT_MODE=${internet_mode})
    target_compile_options(guardian_internet_${application} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_link_libraries(guardian_internet_${application} PRIVATE ws2_32 mswsock winhttp crypt32 secur32 dnsapi iphlpapi)
    target_link_options(guardian_internet_${application} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_internet_${application} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-internet-${application} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet/$<CONFIG>")
    add_dependencies(guardian_internet guardian_internet_${application})
    if(BUILD_TESTING AND application MATCHES "^(sockets|http|timeout)$")
        add_executable(internet_${application}_reference guest/fixtures/InternetClientProbe.cpp)
        target_compile_definitions(internet_${application}_reference PRIVATE INTERNET_CLIENT_MODE=${internet_mode} INTERNET_REFERENCE=1)
        target_compile_options(internet_${application}_reference PRIVATE /W4 /WX /utf-8 /permissive-)
        target_link_libraries(internet_${application}_reference PRIVATE ws2_32 mswsock winhttp crypt32 secur32 dnsapi iphlpapi)
        add_dependencies(guardian_internet internet_${application}_reference)
    endif()
    math(EXPR internet_mode "${internet_mode}+1")
endforeach()
add_executable(guardian_internet_wininet_probe guest/fixtures/InternetWininetProbe.cpp)
target_compile_options(guardian_internet_wininet_probe PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
target_link_libraries(guardian_internet_wininet_probe PRIVATE wininet)
target_link_options(guardian_internet_wininet_probe PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
set_target_properties(guardian_internet_wininet_probe PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-internet-wininet RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/internet/$<CONFIG>")
add_dependencies(guardian_internet guardian_internet_wininet_probe)
if(BUILD_TESTING)
    add_executable(internet_wininet_reference guest/fixtures/InternetWininetProbe.cpp)
    target_compile_definitions(internet_wininet_reference PRIVATE INTERNET_REFERENCE=1)
    target_compile_options(internet_wininet_reference PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(internet_wininet_reference PRIVATE wininet)
    add_dependencies(guardian_internet internet_wininet_reference)
endif()

if(BUILD_TESTING)
    foreach(scenario IN ITEMS crypto sockets http tls sspi reference)
        add_test(NAME internet_${scenario}_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/InternetIntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}" --evidence "${PROJECT_BINARY_DIR}/internet-${scenario}-$<CONFIG>" --case ${scenario})
        set_tests_properties(internet_${scenario}_integration PROPERTIES TIMEOUT 240 RUN_SERIAL TRUE)
    endforeach()
    add_test(NAME internet_runtime_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/InternetRuntimeToolsTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}")
    set_tests_properties(internet_runtime_tools PROPERTIES TIMEOUT 90)
endif()
