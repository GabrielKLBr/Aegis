    target_link_libraries(native_gui_broker_tests PRIVATE guardian_abi user32 gdi32 advapi32 bcrypt)
    target_compile_definitions(native_gui_broker_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN NATIVE_GUI_TESTING=1)
    target_compile_options(native_gui_broker_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_dependencies(native_gui_broker_tests guardian-native-gui-host)
    add_test(NAME native_gui_broker COMMAND native_gui_broker_tests $<TARGET_FILE:guardian-native-gui-host>)
    set_tests_properties(native_gui_broker PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
    add_dependencies(guardian_native_gui native_gui_core_tests native_gui_broker_tests)
