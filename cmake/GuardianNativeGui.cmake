option(GUARDIAN_BUILD_NATIVE_GUI "Build phase 14.10A mediated native GUI" ${GUARDIAN_BUILD_WINDOW_BRIDGE})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_NATIVE_GUI OR NOT TARGET guardian_kernel_integrated)
    return()
endif()
add_executable(guardian_kernel_native_gui)
get_target_property(native_gui_sources guardian_kernel_integrated SOURCES)
target_sources(guardian_kernel_native_gui PRIVATE ${native_gui_sources})
target_link_libraries(guardian_kernel_native_gui PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_integrated ${property})
    set_property(TARGET guardian_kernel_native_gui PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_native_gui PRIVATE GUARDIAN_NATIVE_GUI=1)
set_target_properties(guardian_kernel_native_gui PROPERTIES OUTPUT_NAME guardian-kernel-native-gui SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_native_gui guardian_kernel_integrated)
add_custom_command(TARGET guardian_kernel_native_gui POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_native_gui> VERBATIM)
add_library(guardian_native_gui_gateway SHARED guest/fixtures/DesktopGateway.cpp guest/fixtures/NativeGuiCall.asm)
guardian_external_flags(guardian_native_gui_gateway)
target_link_options(guardian_native_gui_gateway PRIVATE /ENTRY:DesktopGatewayEntry /EXPORT:GuardianNativeGuiCall)
set_target_properties(guardian_native_gui_gateway PROPERTIES OUTPUT_NAME guardian-native-gui RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-gui/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-gui-imports/$<CONFIG>")
add_executable(guardian-native-gui-host src/microvm/gui/NativeGuiWorker.cpp src/microvm/gui/NativeGuiCore.cpp)
target_link_libraries(guardian-native-gui-host PRIVATE guardian_abi user32 gdi32 advapi32)
target_compile_definitions(guardian-native-gui-host PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(guardian-native-gui-host PRIVATE /W4 /WX /utf-8 /permissive-)
target_link_libraries(guardian-desktop PRIVATE advapi32)
add_dependencies(guardian-desktop guardian-native-gui-host)
add_custom_target(guardian_native_gui DEPENDS guardian_window_bridge guardian_kernel_native_gui guardian-native-gui-host guardian_native_gui_gateway)
foreach(mode IN ITEMS demo crash hang)
    add_executable(guardian_native_gui_${mode} guest/fixtures/NativeGuiDemo.cpp)
    target_compile_options(guardian_native_gui_${mode} PRIVATE /W4 /WX /utf-8 /permissive-)
    target_link_libraries(guardian_native_gui_${mode} PRIVATE guardian_abi guardian_native_gui_gateway)
    target_link_options(guardian_native_gui_${mode} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set_target_properties(guardian_native_gui_${mode} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME guardian-native-gui-${mode} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-gui/$<CONFIG>")
    if(mode STREQUAL "crash")
        target_compile_definitions(guardian_native_gui_${mode} PRIVATE NATIVE_GUI_MODE=1)
    elseif(mode STREQUAL "hang")
        target_compile_definitions(guardian_native_gui_${mode} PRIVATE NATIVE_GUI_MODE=2)
    else()
        target_compile_definitions(guardian_native_gui_${mode} PRIVATE NATIVE_GUI_MODE=0)
    endif()
    add_dependencies(guardian_native_gui guardian_native_gui_${mode})
endforeach()
