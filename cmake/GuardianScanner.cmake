# Phase 14: pinned, source-built dependencies; no executable sample is run here.
option(GUARDIAN_BUILD_SCANNER "Build the phase-14 scanner and worker" ON)
if(NOT GUARDIAN_BUILD_SCANNER)
    message(FATAL_ERROR "The Windows/Linux scanner frontends require GUARDIAN_BUILD_SCANNER=ON")
endif()
enable_language(C)
include(FetchContent)
if(POLICY CMP0169)
    cmake_policy(SET CMP0169 OLD)
endif()
set(GUARDIAN_SCANNER_DEPS "" CACHE PATH "Verified scanner dependency source cache")
file(READ "${CMAKE_CURRENT_LIST_DIR}/ScannerDependencies.json" scanner_lock)
string(JSON scanner_dep_count LENGTH "${scanner_lock}" packages)
math(EXPR scanner_dep_last "${scanner_dep_count}-1")
foreach(i RANGE ${scanner_dep_last})
    string(JSON dep GET "${scanner_lock}" packages ${i} name)
    if(GUARDIAN_SCANNER_DEPS AND EXISTS "${GUARDIAN_SCANNER_DEPS}/${dep}")
        set(scanner_${dep}_SOURCE_DIR "${GUARDIAN_SCANNER_DEPS}/${dep}")
    else()
        string(JSON url GET "${scanner_lock}" packages ${i} url)
        string(JSON sha GET "${scanner_lock}" packages ${i} sha256)
        FetchContent_Declare(scanner_${dep} URL "${url}" URL_HASH "SHA256=${sha}" TLS_VERIFY ON)
        # Source population only: YARA/SQLite use the explicit targets below.
        FetchContent_GetProperties(scanner_${dep})
        if(NOT scanner_${dep}_POPULATED)
            FetchContent_Populate(scanner_${dep})
        endif()
    endif()
endforeach()
add_library(scanner_json INTERFACE)
target_include_directories(scanner_json INTERFACE "${scanner_json_SOURCE_DIR}" "${scanner_json_SOURCE_DIR}/include")
set(ZLIB_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(ZLIB_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ZLIB_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory("${scanner_zlib_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/scanner-deps/zlib" EXCLUDE_FROM_ALL)
set(ZLIB_INCLUDE_DIR "${scanner_zlib_SOURCE_DIR}" CACHE PATH "" FORCE)
set(ZLIB_LIBRARY zlibstatic CACHE STRING "" FORCE)
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
endif()
set(BUILD_SHARED_LIBS OFF)
foreach(opt ENABLE_TEST ENABLE_INSTALL ENABLE_TAR ENABLE_CPIO ENABLE_CAT ENABLE_OPENSSL ENABLE_LIBB2 ENABLE_LZMA ENABLE_BZip2 ENABLE_LZ4 ENABLE_ZSTD ENABLE_EXPAT ENABLE_PCREPOSIX ENABLE_PCRE2POSIX ENABLE_ACL ENABLE_XATTR ENABLE_ICONV)
    set(${opt} OFF CACHE BOOL "Scanner read-only format subset" FORCE)
endforeach()
set(ENABLE_ZLIB ON CACHE BOOL "" FORCE)
add_subdirectory("${scanner_libarchive_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/scanner-deps/archive" EXCLUDE_FROM_ALL)
add_library(scanner_sqlite STATIC "${scanner_sqlite_SOURCE_DIR}/sqlite3.c")
target_include_directories(scanner_sqlite PUBLIC "${scanner_sqlite_SOURCE_DIR}")
target_compile_definitions(scanner_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION SQLITE_DQS=0 SQLITE_DEFAULT_MEMSTATUS=0)
file(GLOB yara_sources CONFIGURE_DEPENDS "${scanner_yara_SOURCE_DIR}/libyara/*.c")
add_library(scanner_yara STATIC ${yara_sources}
    "${scanner_yara_SOURCE_DIR}/libyara/proc/none.c"
    "${scanner_yara_SOURCE_DIR}/libyara/modules/math/math.c"
    "${scanner_yara_SOURCE_DIR}/libyara/modules/time/time.c"
    "${scanner_yara_SOURCE_DIR}/libyara/modules/string/string.c"
    "${scanner_yara_SOURCE_DIR}/libyara/modules/pe/pe.c"
    "${scanner_yara_SOURCE_DIR}/libyara/modules/pe/pe_utils.c")
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/scanner-generated/modules")
file(WRITE "${PROJECT_BINARY_DIR}/scanner-generated/modules/module_list" "MODULE(pe)\nMODULE(math)\nMODULE(time)\nMODULE(string)\n")
target_include_directories(scanner_yara PUBLIC "${scanner_yara_SOURCE_DIR}/libyara/include"
    PRIVATE "${PROJECT_BINARY_DIR}/scanner-generated" "${scanner_yara_SOURCE_DIR}/libyara")
target_compile_definitions(scanner_yara PRIVATE USE_NO_PROC)
if(MSVC)
    target_compile_definitions(scanner_yara PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_compile_options(scanner_yara PRIVATE /W1 /FIstdint.h)
    target_compile_options(scanner_sqlite PRIVATE /W1)
    target_link_libraries(scanner_yara PRIVATE advapi32)
else()
    find_package(Threads REQUIRED)
    target_compile_definitions(scanner_yara PRIVATE HAVE_CLOCK_GETTIME=1 HAVE_STDBOOL_H=1 HAVE_STRCASECMP=1 HAVE_STRNCASECMP=1)
    target_link_libraries(scanner_yara PRIVATE Threads::Threads m)
    target_link_libraries(scanner_sqlite PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
endif()
add_library(guardian_scanner STATIC src/scanner/Cli.cpp src/scanner/Support.cpp src/scanner/Static.cpp
    src/scanner/Store.cpp src/scanner/Intelligence.cpp src/scanner/Engine.cpp src/scanner/Worker.cpp)
target_include_directories(guardian_scanner PUBLIC "${PROJECT_SOURCE_DIR}/src")
file(GLOB scanner_fingerprint_inputs CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/scanner/*.cpp" "${PROJECT_SOURCE_DIR}/src/scanner/*.h")
list(APPEND scanner_fingerprint_inputs "${CMAKE_CURRENT_LIST_FILE}" "${CMAKE_CURRENT_LIST_DIR}/ScannerDependencies.json")
file(GLOB scanner_sandbox_fingerprint CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/src/microvm/host/*.h"
    "${PROJECT_SOURCE_DIR}/src/microvm/host/*.cpp" "${PROJECT_SOURCE_DIR}/src/microvm/MicroSandbox.*"
    "${PROJECT_SOURCE_DIR}/src/microvm/vmm/*.h" "${PROJECT_SOURCE_DIR}/src/microvm/vmm/*.cpp")
list(APPEND scanner_fingerprint_inputs ${scanner_sandbox_fingerprint})
set(scanner_fingerprint "")
foreach(input IN LISTS scanner_fingerprint_inputs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(SHA256 "${input}" input_hash)
    string(APPEND scanner_fingerprint "${input_hash}")
endforeach()
string(APPEND scanner_fingerprint "${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}/${CMAKE_SIZEOF_VOID_P}/${CMAKE_CXX_COMPILER_ID}/${CMAKE_CXX_COMPILER_VERSION}")
string(SHA256 scanner_fingerprint "${scanner_fingerprint}")
target_compile_definitions(guardian_scanner PRIVATE GUARDIAN_SCANNER_REV="${scanner_fingerprint}" GUARDIAN_SCANNER_CONFIGURATION="$<CONFIG>")
target_compile_definitions(guardian_scanner PRIVATE LIBARCHIVE_STATIC)
target_link_libraries(guardian_scanner PUBLIC scanner_json PRIVATE scanner_yara scanner_sqlite archive_static)
target_include_directories(guardian_scanner PRIVATE "${scanner_libarchive_SOURCE_DIR}/libarchive" "${PROJECT_BINARY_DIR}/scanner-deps/archive")
if(WIN32)
    target_link_libraries(guardian_scanner PRIVATE bcrypt winhttp advapi32)
else()
    # Native pkg-config avoids picking Windows/MSYS headers from WSL's PATH.
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(SCANNER_CURL QUIET IMPORTED_TARGET libcurl>=7.85)
    endif()
    target_link_libraries(guardian_scanner PRIVATE OpenSSL::Crypto)
    if(SCANNER_CURL_FOUND)
        target_link_libraries(guardian_scanner PRIVATE PkgConfig::SCANNER_CURL)
        target_compile_definitions(guardian_scanner PRIVATE GUARDIAN_SCANNER_CURL)
    else()
        message(STATUS "Scanner: offline Linux build; install libcurl development files for HTTPS transport")
    endif()
endif()
add_executable(guardian-scan src/scanner/Main.cpp)
add_executable(guardian-scan-worker src/scanner/WorkerMain.cpp)
target_link_libraries(guardian-scan PRIVATE guardian_scanner)
target_link_libraries(guardian-scan-worker PRIVATE guardian_scanner)
if(WIN32 AND TARGET guardian_boot_core)
    add_library(scanner_sandbox STATIC src/microvm/MicroSandbox.cpp src/microvm/host/PeLoader.cpp
        src/microvm/host/VirtualFs.cpp src/microvm/host/VirtualRegistry.cpp src/microvm/host/ProcessEnv.cpp
        src/microvm/host/ReportBuilder.cpp src/microvm/host/NtKernel.cpp)
    target_link_libraries(scanner_sandbox PUBLIC guardian_boot_core)
    target_compile_definitions(scanner_sandbox PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(guardian-scan-worker PRIVATE scanner_sandbox)
    target_compile_definitions(guardian-scan-worker PRIVATE GUARDIAN_SCANNER_VM)
endif()
add_dependencies(guardian-scan guardian-scan-worker)
add_custom_command(TARGET guardian-scan POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "${PROJECT_SOURCE_DIR}/signatures.txt" "$<TARGET_FILE_DIR:guardian-scan>/signatures.txt" VERBATIM)
foreach(t guardian_scanner guardian-scan guardian-scan-worker)
    if(MSVC)
        target_compile_options(${t} PRIVATE /W4 /WX /utf-8 /permissive-)
        target_compile_definitions(${t} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    else()
        target_compile_options(${t} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
target_link_libraries(av PRIVATE guardian_scanner)
add_dependencies(av guardian-scan-worker)
if(TARGET avui)
    target_link_libraries(avui PRIVATE guardian_scanner)
    add_dependencies(avui guardian-scan-worker)
endif()
if(BUILD_TESTING)
    add_executable(scanner_core_tests test/ScannerCoreTests.cpp)
    target_link_libraries(scanner_core_tests PRIVATE guardian_scanner)
    add_dependencies(scanner_core_tests guardian-scan-worker)
    add_test(NAME scanner_core COMMAND scanner_core_tests "${PROJECT_BINARY_DIR}/scanner-core-$<CONFIG>")
    add_test(NAME scanner_pipeline COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/ScannerPipelineTests.py"
        $<TARGET_FILE:guardian-scan> "${PROJECT_BINARY_DIR}/scanner-pipeline-$<CONFIG>")
    set_tests_properties(scanner_core scanner_pipeline PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    if(WIN32)
        add_executable(scanner_facade_tests test/ScannerFacadeTests.cpp src/EngineFacade.cpp src/SignatureDatabase.cpp
            src/Scanner.cpp src/Quarantine.cpp src/Sha256.cpp src/Util.cpp)
        target_link_libraries(scanner_facade_tests PRIVATE guardian_scanner)
        target_compile_definitions(scanner_facade_tests PRIVATE NOMINMAX)
        target_compile_options(scanner_facade_tests PRIVATE /W4 /WX /utf-8 /permissive-)
        add_dependencies(scanner_facade_tests guardian-scan-worker)
        add_test(NAME scanner_facade COMMAND scanner_facade_tests "${PROJECT_BINARY_DIR}/scanner-facade-$<CONFIG>")
        set_tests_properties(scanner_facade PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE)
    endif()
endif()
install(TARGETS guardian-scan guardian-scan-worker RUNTIME DESTINATION bin)
if(TARGET guardian_whp_memory)
    install(TARGETS guardian_whp_memory RUNTIME DESTINATION bin)
endif()
install(FILES "${PROJECT_SOURCE_DIR}/signatures.txt" DESTINATION bin)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/third-party/" DESTINATION share/aegis/licenses)
