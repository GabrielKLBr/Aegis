option(GUARDIAN_BUILD_NATIVE_NT "Build the phase 14.3 native NT runtime" ${GUARDIAN_BUILD_EXTERNAL_PE})
set(GUARDIAN_NATIVE_REFERENCE_DLL "" CACHE FILEPATH "Legally supplied target Windows 10 x64 ntdll.dll; never collected from the host")
if(NOT WIN32 OR NOT GUARDIAN_BUILD_NATIVE_NT OR NOT TARGET guardian_kernel_external_pe)
    return()
endif()
set(native_generated "${PROJECT_BINARY_DIR}/native-generated")
file(MAKE_DIRECTORY "${native_generated}")
add_custom_command(OUTPUT "${native_generated}/NativeWrappers.cpp" "${native_generated}/NativeExports.def"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/native_nt.py" wrappers "${native_generated}/NativeWrappers.cpp" "${native_generated}/NativeExports.def"
    DEPENDS tools/native_nt.py guest/fixtures/NativeApi.h shared/guardian/NativeNt.h VERBATIM)
add_library(guardian_native_ntdll SHARED "${native_generated}/NativeWrappers.cpp" "${native_generated}/NativeExports.def"
    guest/fixtures/NativeRtl.cpp guest/fixtures/NativeCall.asm guest/Memory.cpp guest/StackProbe.asm)
guardian_external_flags(guardian_native_ntdll)
target_compile_definitions(guardian_native_ntdll PRIVATE GUARDIAN_NATIVE_NT=1)
target_link_libraries(guardian_native_ntdll PRIVATE guardian_external_runtime)
target_link_options(guardian_native_ntdll PRIVATE /ENTRY:NativeDllEntry /INCLUDE:_tls_used)
set_target_properties(guardian_native_ntdll PROPERTIES OUTPUT_NAME ntdll
    RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native/$<CONFIG>"
    ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native-imports/$<CONFIG>")
foreach(kind IN ITEMS owned original)
    add_executable(guardian_native_${kind}_application guest/fixtures/NativeApplication.cpp guest/fixtures/NativeUnknown.asm guest/Memory.cpp guest/StackProbe.asm)
    guardian_external_flags(guardian_native_${kind}_application)
    target_compile_definitions(guardian_native_${kind}_application PRIVATE GUARDIAN_NATIVE_NT=1)
    target_link_libraries(guardian_native_${kind}_application PRIVATE guardian_native_ntdll guardian_external_runtime)
    target_link_options(guardian_native_${kind}_application PRIVATE /SUBSYSTEM:CONSOLE /ENTRY:GuardianEntry)
    set_target_properties(guardian_native_${kind}_application PROPERTIES OUTPUT_NAME guardian-native-${kind}
        RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/native/$<CONFIG>")
    if(kind STREQUAL original)
        target_compile_definitions(guardian_native_${kind}_application PRIVATE GUARDIAN_NATIVE_REFERENCE=1)
    endif()
endforeach()
add_executable(guardian_kernel_native_nt)
get_target_property(native_kernel_sources guardian_kernel_external_pe SOURCES)
target_sources(guardian_kernel_native_nt PRIVATE ${native_kernel_sources} guest/NativeServices.cpp guest/Volume.cpp)
target_link_libraries(guardian_kernel_native_nt PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_external_pe ${property})
    set_property(TARGET guardian_kernel_native_nt PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_native_nt PRIVATE GUARDIAN_NATIVE_NT=1)
set_target_properties(guardian_kernel_native_nt PROPERTIES OUTPUT_NAME guardian-kernel-native-nt SUFFIX .gk
    RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY ""
    VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_native_nt guardian_pe_fixtures guardian_runtime_fixtures guardian_complete_fixtures guardian_gui_runtime)
add_custom_command(TARGET guardian_kernel_native_nt POST_BUILD COMMAND "${Python3_EXECUTABLE}"
    "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_native_nt> VERBATIM)
if(BUILD_TESTING)
    add_test(NAME native_nt_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/NativeNtToolTests.py")
    add_executable(native_nt_windows_reference_tests test/NativeNtWindowsReferenceTests.cpp)
    target_link_libraries(native_nt_windows_reference_tests PRIVATE guardian_abi)
    target_compile_options(native_nt_windows_reference_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME native_nt_windows_reference COMMAND native_nt_windows_reference_tests)
    add_executable(native_nt_unwind_tests test/NativeUnwindTests.cpp guest/Unwind.cpp)
    target_link_libraries(native_nt_unwind_tests PRIVATE guardian_abi)
    target_compile_definitions(native_nt_unwind_tests PRIVATE GUARDIAN_SCALABLE_PE=1 GUARDIAN_NATIVE_NT=1)
    target_compile_options(native_nt_unwind_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME native_nt_unwind COMMAND native_nt_unwind_tests)
    add_executable(native_nt_core_tests test/NativeNtCoreTests.cpp guest/NativeServices.cpp guest/Volume.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    target_link_libraries(native_nt_core_tests PRIVATE guardian_abi)
    target_compile_definitions(native_nt_core_tests PRIVATE GUARDIAN_SCALABLE_PE=1 GUARDIAN_NATIVE_NT=1)
    target_compile_options(native_nt_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME native_nt_core COMMAND native_nt_core_tests)
    add_test(NAME native_nt_owned_boot COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/NativeNtIntegrationTests.py"
        --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --evidence "${PROJECT_BINARY_DIR}/native-owned-$<CONFIG>")
    set_tests_properties(native_nt_owned_boot PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    if(GUARDIAN_NATIVE_REFERENCE_DLL)
        add_test(NAME native_nt_original_boot COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/NativeNtIntegrationTests.py"
            --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --evidence "${PROJECT_BINARY_DIR}/native-original-$<CONFIG>" --original "${GUARDIAN_NATIVE_REFERENCE_DLL}")
        set_tests_properties(native_nt_original_boot PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE)
    endif()
endif()
