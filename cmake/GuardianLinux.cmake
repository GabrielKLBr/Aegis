# Native ELF tools plus the same guest algorithms used by the Windows build.
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "The native validation currently requires Linux x86-64.")
endif()
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()
option(GUARDIAN_ENABLE_SANITIZERS "Enable native AddressSanitizer/UndefinedBehaviorSanitizer" OFF)
add_compile_options(-Wall -Wextra -Wno-misleading-indentation)
if(GUARDIAN_ENABLE_SANITIZERS)
    # PIE/ASan address layouts can collide under some Linux ASLR configurations.
    add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-pie)
    add_link_options(-fsanitize=address,undefined -no-pie)
endif()
find_package(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
add_library(guardian_abi INTERFACE)
target_include_directories(guardian_abi INTERFACE "${PROJECT_SOURCE_DIR}/shared")
target_compile_features(guardian_abi INTERFACE cxx_std_20)
add_library(guardian_guest_core STATIC
    guest/MemoryManager.cpp guest/Scheduler.cpp guest/ProcessManager.cpp
    guest/ProcessChecks.cpp guest/SchedulerChecks.cpp guest/IoManager.cpp
    guest/IoChecks.cpp guest/Volume.cpp guest/StorageChecks.cpp guest/PeServices.cpp
    guest/PeLoader.cpp guest/Unwind.cpp guest/ExceptionDispatch.cpp)
target_link_libraries(guardian_guest_core PUBLIC guardian_abi)
target_compile_options(guardian_guest_core PRIVATE -ffreestanding -fno-exceptions -fno-rtti)
add_library(guardian_boot_format STATIC src/microvm/boot/KernelImage.cpp src/microvm/boot/BootChannel.cpp)
target_link_libraries(guardian_boot_format PUBLIC guardian_abi)
add_executable(av src/linux/Main.cpp)
set_target_properties(av PROPERTIES OUTPUT_NAME guardianav)
target_link_libraries(av PRIVATE OpenSSL::Crypto guardian_boot_format)
find_package(Threads REQUIRED)
add_library(guardian_kvm STATIC src/linux/KvmCli.cpp src/linux/KvmMachine.cpp src/linux/PersistentBlockStore.cpp
    src/microvm/boot/KernelBoot.cpp src/microvm/boot/SessionSnapshot.cpp src/microvm/state/Files.cpp src/microvm/boot/IoBackend.cpp)
target_link_libraries(guardian_kvm PUBLIC guardian_boot_format Threads::Threads)
target_compile_definitions(guardian_kvm PRIVATE GUARDIAN_BOOT_CONFIGURATION="${CMAKE_BUILD_TYPE}")
add_executable(guardian-kvm src/linux/KvmMain.cpp)
target_link_libraries(guardian-kvm PRIVATE guardian_kvm)
target_link_libraries(av PRIVATE guardian_kvm)
add_custom_command(TARGET av POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "${PROJECT_SOURCE_DIR}/signatures.txt" "$<TARGET_FILE_DIR:av>/signatures.txt" VERBATIM)
install(TARGETS av RUNTIME DESTINATION bin)
install(TARGETS guardian-kvm RUNTIME DESTINATION bin)
install(FILES signatures.txt DESTINATION share/guardianav)

include(CTest)
if(BUILD_TESTING)
    set(GUARDIAN_NATIVE_FIXTURE_DIR "${PROJECT_SOURCE_DIR}/test/fixtures/native" CACHE PATH
        "Owned parser inputs; source-only checkouts can generate these outside the source tree")
    set(native_fixture_dir "${GUARDIAN_NATIVE_FIXTURE_DIR}")
    if(NOT EXISTS "${native_fixture_dir}/guardian-kernel.gk")
        message(FATAL_ERROR "Parser fixtures are not committed. Build the owned guests, run tools/prepare_source_fixtures.py, and set GUARDIAN_NATIVE_FIXTURE_DIR. See docs/GITHUB-AEGIS.md.")
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/verify_native_fixtures.py"
        "${native_fixture_dir}" COMMAND_ERROR_IS_FATAL ANY)
    set(native_pe_header "${PROJECT_BINARY_DIR}/generated/PeFixtures.h")
    add_custom_command(OUTPUT "${native_pe_header}"
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/embed_pe_fixtures.py" "${native_pe_header}"
            "${native_fixture_dir}/guardian-pe-console.exe" "${native_fixture_dir}/guardian-pe-runtime.dll"
        DEPENDS "${native_fixture_dir}/guardian-pe-console.exe" "${native_fixture_dir}/guardian-pe-runtime.dll"
                "${PROJECT_SOURCE_DIR}/tools/embed_pe_fixtures.py" VERBATIM)
    add_library(guardian_guest_contract OBJECT guest/ContractCheck.cpp)
    target_link_libraries(guardian_guest_contract PRIVATE guardian_abi)
    target_compile_options(guardian_guest_contract PRIVATE -ffreestanding -fno-exceptions -fno-rtti)
    function(guardian_native_test name source)
        add_executable(${name}_tests ${source} ${ARGN})
        target_link_libraries(${name}_tests PRIVATE guardian_guest_core guardian_boot_format)
        add_test(NAME ${name} COMMAND ${name}_tests)
        set_tests_properties(${name} PROPERTIES TIMEOUT 60)
    endfunction()
    guardian_native_test(guest_contract test/GuestContractTests.cpp $<TARGET_OBJECTS:guardian_guest_contract>)
    guardian_native_test(guest_cpu_contract test/GuestCpuContractTests.cpp)
    guardian_native_test(guest_memory test/GuestMemoryTests.cpp)
    guardian_native_test(guest_scheduler_core test/GuestSchedulerCoreTests.cpp)
    guardian_native_test(guest_process_core test/GuestProcessCoreTests.cpp)
    guardian_native_test(guest_io_core test/GuestIoCoreTests.cpp)
    guardian_native_test(guest_storage_core test/GuestStorageCoreTests.cpp)
    guardian_native_test(guest_runtime_core test/GuestRuntimeCoreTests.cpp)
    guardian_native_test(guest_exception_dispatch test/GuestExceptionDispatchTests.cpp)
    guardian_native_test(guest_unwind_core test/GuestUnwindTests.cpp)
    guardian_native_test(guest_unwind_handlers test/GuestUnwindHandlerTests.cpp)
    guardian_native_test(guest_pe_loader test/GuestPeLoaderTests.cpp "${native_pe_header}")
    target_include_directories(guest_pe_loader_tests PRIVATE "${PROJECT_BINARY_DIR}/generated" "${PROJECT_SOURCE_DIR}/guest")
    guardian_native_test(guest_boot_protocol test/GuestBootProtocolTests.cpp)
    add_executable(guest_kernel_image_tests test/GuestKernelImageTests.cpp)
    target_link_libraries(guest_kernel_image_tests PRIVATE guardian_boot_format)
    add_test(NAME guest_kernel_image COMMAND guest_kernel_image_tests "${native_fixture_dir}/guardian-kernel.gk")
    add_test(NAME guest_kernel_canonical_image COMMAND "${Python3_EXECUTABLE}"
        "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" "${native_fixture_dir}/guardian-kernel.gk" --self-test)
    add_test(NAME guest_audit_negative COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/check_guest_object.py" --self-test)
    add_test(NAME native_fixtures COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/verify_native_fixtures.py" "${native_fixture_dir}")
    add_test(NAME linux_scanner COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/LinuxScannerTests.py" $<TARGET_FILE:av>)
    set_tests_properties(linux_scanner PROPERTIES TIMEOUT 60)
    add_executable(guest_storage_host_tests test/GuestStorageHostTests.cpp)
    target_link_libraries(guest_storage_host_tests PRIVATE guardian_guest_core guardian_kvm)
    add_test(NAME guest_storage_host COMMAND guest_storage_host_tests "${PROJECT_BINARY_DIR}/test-volumes")
    option(GUARDIAN_TEST_KVM "Run real guests; fail if KVM is unavailable" OFF)
    set(GUARDIAN_KVM_GUEST_DIR "" CACHE PATH "Fresh guest image build for KVM tests")
    if(GUARDIAN_TEST_KVM)
        if(NOT EXISTS "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-cpu.gk")
            message(FATAL_ERROR "Build guest images first and set GUARDIAN_KVM_GUEST_DIR")
        endif()
        add_executable(guest_kvm_tests test/GuestKvmTests.cpp)
        target_link_libraries(guest_kvm_tests PRIVATE guardian_kvm)
        add_test(NAME guest_kvm COMMAND guest_kvm_tests "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel.gk" "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-cpu.gk")
        set_tests_properties(guest_kvm PROPERTIES TIMEOUT 30)
    endif()
endif()
message(STATUS "Native Linux: ELF scanner, KVM, shared-core tests and explicit guest graphics viewer. Windows UI/oracles require Windows.")

