# Phase 13: guest event collection, bounded input validation and behavioral rules.
if(NOT BUILD_TESTING)
    return()
endif()
if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(analysis_core guardian_boot_core)
else()
    set(analysis_core guardian_kvm)
endif()
add_executable(analysis_core_tests test/AnalysisCoreTests.cpp)
add_executable(analysis_boot_tests test/AnalysisBootTests.cpp)
foreach(analysis_target IN ITEMS analysis_core_tests analysis_boot_tests)
    target_link_libraries(${analysis_target} PRIVATE ${analysis_core})
    if(WIN32)
        target_sources(${analysis_target} PRIVATE guest/Volume.cpp guest/Scheduler.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp)
        target_compile_definitions(${analysis_target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(${analysis_target} PRIVATE /W4 /WX /utf-8 /permissive-)
    else()
        target_link_libraries(${analysis_target} PRIVATE guardian_guest_core)
        target_compile_options(${analysis_target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
add_test(NAME analysis_core COMMAND analysis_core_tests "${PROJECT_BINARY_DIR}/analysis-core-$<CONFIG>")
set_tests_properties(analysis_core PROPERTIES TIMEOUT 40)
if(WIN32 OR GUARDIAN_TEST_KVM)
    if(WIN32)
        set(analysis_kernel $<TARGET_FILE:guardian_kernel_analysis>)
        add_dependencies(analysis_boot_tests guardian_kernel_analysis)
    else()
        set(analysis_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-analysis.gk")
    endif()
    add_test(NAME analysis_boot COMMAND analysis_boot_tests "${analysis_kernel}" "${PROJECT_BINARY_DIR}/analysis-boots-$<CONFIG>")
    set_tests_properties(analysis_boot PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    add_test(NAME analysis_lifecycle COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/AnalysisLifecycleTests.py" $<TARGET_FILE:guardian-vm> "${analysis_kernel}" "${PROJECT_BINARY_DIR}/analysis-lifecycle-$<CONFIG>")
    set_tests_properties(analysis_lifecycle PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
endif()
if(WIN32 AND TARGET guardian_reference)
    add_dependencies(guardian_reference analysis_core_tests analysis_boot_tests)
endif()
