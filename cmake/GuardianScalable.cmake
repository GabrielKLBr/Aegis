target_sources(${guardian_resources_core} PRIVATE guest/ScalableVolume.cpp src/microvm/storage/DiskLocation.cpp src/microvm/storage/SparseDisk.cpp src/microvm/vmm/SmpMachine.cpp src/microvm/boot/ResourceSession.cpp)
