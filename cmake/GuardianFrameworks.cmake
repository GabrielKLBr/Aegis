option(GUARDIAN_BUILD_FRAMEWORKS "Build the bounded 14.11 framework runtime" ${GUARDIAN_BUILD_AUDIO})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_FRAMEWORKS OR NOT TARGET guardian_kernel_audio)
    return()
endif()
add_executable(guardian-cli-inspect src/microvm/host/CliInspector.cpp)
target_link_libraries(guardian-cli-inspect PRIVATE guardian_abi)
target_compile_options(guardian-cli-inspect PRIVATE /W4 /WX /utf-8 /permissive-)
add_executable(guardian-framework-tests test/FrameworkTests.cpp)
target_link_libraries(guardian-framework-tests PRIVATE guardian_abi)
target_compile_options(guardian-framework-tests PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
add_executable(guardian_framework_copy-client guest/fixtures/frameworks/CopyClient.cpp guest/Memory.cpp)
guardian_external_flags(guardian_framework_copy-client)
target_link_libraries(guardian_framework_copy-client PRIVATE kernel32)
target_link_options(guardian_framework_copy-client PRIVATE /ENTRY:FrameworkCopyClient /SUBSYSTEM:CONSOLE)
set_target_properties(guardian_framework_copy-client PROPERTIES OUTPUT_NAME guardian-framework-copy-client RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>")
option(GUARDIAN_FRAMEWORKS_ASAN "Instrument only the host CIL parser test with AddressSanitizer" OFF)
if(GUARDIAN_FRAMEWORKS_ASAN)
    target_compile_options(guardian-framework-tests PRIVATE /fsanitize=address /Zi)
    target_link_options(guardian-framework-tests PRIVATE /INCREMENTAL:NO /DEBUG)
    set_target_properties(guardian-framework-tests PROPERTIES MSVC_RUNTIME_CHECKS "" VS_JUST_MY_CODE_DEBUGGING FALSE)
endif()

# A separate kernel keeps the earlier phases' image contract unchanged.
add_executable(guardian_kernel_frameworks)
get_target_property(framework_sources guardian_kernel_audio SOURCES)
target_sources(guardian_kernel_frameworks PRIVATE ${framework_sources} guest/Framework.cpp)
target_link_libraries(guardian_kernel_frameworks PRIVATE guardian_abi)
foreach(prop IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_audio ${prop})
    set_property(TARGET guardian_kernel_frameworks PROPERTY ${prop} "${value}")
endforeach()

set_target_properties(guardian_kernel_frameworks PROPERTIES OUTPUT_NAME guardian-kernel-frameworks SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_custom_command(TARGET guardian_kernel_frameworks POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_frameworks> VERBATIM)

add_library(guardian_framework_mscoree SHARED guest/fixtures/FrameworkCli.cpp guest/Memory.cpp guest/StackProbe.asm guest/fixtures/FrameworkMscoree.def)
guardian_external_flags(guardian_framework_mscoree)
target_link_libraries(guardian_framework_mscoree PRIVATE guardian_desktop_kernel32)
target_link_options(guardian_framework_mscoree PRIVATE /ENTRY:FrameworkCliEntry)
set_target_properties(guardian_framework_mscoree PROPERTIES OUTPUT_NAME mscoree RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks-imports/$<CONFIG>")
add_custom_target(guardian_framework_runtime DEPENDS guardian_audio_runtime guardian_kernel_frameworks guardian_framework_mscoree guardian-cli-inspect guardian_whp_memory)
add_dependencies(guardian_framework_runtime guardian_framework_copy-client)

set(framework_com_def "${PROJECT_BINARY_DIR}/framework-generated/combase.def")
add_custom_command(OUTPUT "${framework_com_def}"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/framework_runtime.py" exports "${component_generated}/combase.def" "${framework_com_def}"
    DEPENDS "${component_generated}/combase.def" tools/framework_runtime.py VERBATIM)
get_target_property(framework_com_sources guardian_audio_combase SOURCES)
list(FILTER framework_com_sources EXCLUDE REGEX "\\.def$")
add_library(guardian_framework_combase SHARED ${framework_com_sources} guest/fixtures/FrameworkWinrt.cpp "${framework_com_def}")
foreach(prop IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS LINK_LIBRARIES MSVC_RUNTIME_LIBRARY MSVC_RUNTIME_CHECKS VS_JUST_MY_CODE_DEBUGGING)
    get_target_property(value guardian_audio_combase ${prop})
    if(NOT value STREQUAL "value-NOTFOUND")
        set_property(TARGET guardian_framework_combase PROPERTY ${prop} "${value}")
    endif()
endforeach()
set_target_properties(guardian_framework_combase PROPERTIES OUTPUT_NAME combase RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks-imports/$<CONFIG>")
target_link_libraries(guardian_framework_combase PRIVATE guardian_desktop_ntdll)
add_dependencies(guardian_framework_runtime guardian_framework_combase)

add_custom_command(OUTPUT "${PROJECT_BINARY_DIR}/framework-generated/kernelbase.def" "${PROJECT_BINARY_DIR}/framework-generated/kernel32.def"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/framework_runtime.py" copy-exports "${desktop_generated}/kernelbase.def" "${desktop_generated}/kernel32.def" "${PROJECT_BINARY_DIR}/framework-generated"
    DEPENDS "${desktop_generated}/kernelbase.def" "${desktop_generated}/kernel32.def" tools/framework_runtime.py VERBATIM)
foreach(part IN ITEMS kernelbase kernel32)
    get_target_property(framework_base_sources guardian_desktop_${part} SOURCES)
    list(FILTER framework_base_sources EXCLUDE REGEX "\\.def$")
    add_library(guardian_framework_${part} SHARED ${framework_base_sources} "${PROJECT_BINARY_DIR}/framework-generated/${part}.def")
    foreach(prop IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS LINK_LIBRARIES MSVC_RUNTIME_LIBRARY MSVC_RUNTIME_CHECKS VS_JUST_MY_CODE_DEBUGGING)
        get_target_property(value guardian_desktop_${part} ${prop})
        if(NOT value STREQUAL "value-NOTFOUND")
            set_property(TARGET guardian_framework_${part} PROPERTY ${prop} "${value}")
        endif()
    endforeach()
    if(part STREQUAL "kernelbase")
        target_sources(guardian_framework_${part} PRIVATE guest/fixtures/FrameworkCopy.cpp)
    endif()
    set_target_properties(guardian_framework_${part} PROPERTIES OUTPUT_NAME ${part} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks-imports/$<CONFIG>")
    add_dependencies(guardian_framework_runtime guardian_framework_${part})
endforeach()

# Independent clients link the Windows SDK, not the guest import libraries.
foreach(client IN ITEMS winrt winrt-negative)
    add_executable(guardian_framework_${client} guest/fixtures/frameworks/WinrtClient.cpp guest/Memory.cpp)
    guardian_external_flags(guardian_framework_${client})
    target_link_libraries(guardian_framework_${client} PRIVATE kernel32 runtimeobject ole32 ntdll uuid)
    target_link_options(guardian_framework_${client} PRIVATE /ENTRY:FrameworkWinrtClient /SUBSYSTEM:CONSOLE)
    set_target_properties(guardian_framework_${client} PROPERTIES OUTPUT_NAME guardian-framework-${client} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>")
    if(client STREQUAL "winrt-negative")
        target_compile_definitions(guardian_framework_${client} PRIVATE FRAMEWORK_UNSUPPORTED_PROBE=1)
    endif()
    add_dependencies(guardian_framework_runtime guardian_framework_${client})
endforeach()

add_library(guardian_framework_version SHARED guest/fixtures/FrameworkVersion.cpp guest/Memory.cpp guest/StackProbe.asm guest/fixtures/FrameworkVersion.def)
guardian_external_flags(guardian_framework_version)
target_link_libraries(guardian_framework_version PRIVATE guardian_desktop_kernel32)
target_link_options(guardian_framework_version PRIVATE /ENTRY:FrameworkVersionEntry)
set_target_properties(guardian_framework_version PROPERTIES OUTPUT_NAME version RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks-imports/$<CONFIG>")
add_dependencies(guardian_framework_runtime guardian_framework_version)

add_executable(guardian_framework_version-client guest/fixtures/frameworks/VersionClient.cpp guest/fixtures/frameworks/VersionClient.rc guest/Memory.cpp)
guardian_external_flags(guardian_framework_version-client)
target_link_libraries(guardian_framework_version-client PRIVATE kernel32 version)
target_link_options(guardian_framework_version-client PRIVATE /ENTRY:FrameworkVersionClient /SUBSYSTEM:CONSOLE)
set_target_properties(guardian_framework_version-client PROPERTIES OUTPUT_NAME guardian-framework-version-client RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>")
add_dependencies(guardian_framework_runtime guardian_framework_version-client)
foreach(mode IN ITEMS install resume uninstall)
    if(mode STREQUAL "install")
        set(mode_id 0)
    elseif(mode STREQUAL "resume")
        set(mode_id 1)
    else()
        set(mode_id 2)
    endif()
    add_executable(guardian_framework_${mode} guest/fixtures/frameworks/Installer.cpp guest/Memory.cpp)
    guardian_external_flags(guardian_framework_${mode})
    target_compile_definitions(guardian_framework_${mode} PRIVATE FRAMEWORK_INSTALL_MODE=${mode_id})
    target_link_libraries(guardian_framework_${mode} PRIVATE kernel32 advapi32)
    target_link_options(guardian_framework_${mode} PRIVATE /ENTRY:FrameworkInstaller /SUBSYSTEM:CONSOLE)
    set_target_properties(guardian_framework_${mode} PROPERTIES OUTPUT_NAME guardian-framework-${mode} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/frameworks/$<CONFIG>")
    add_dependencies(guardian_framework_runtime guardian_framework_${mode})
endforeach()
target_compile_definitions(guardian_kernel_frameworks PRIVATE GUARDIAN_FRAMEWORKS=1)
