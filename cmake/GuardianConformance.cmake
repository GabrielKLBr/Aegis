# Phase 12C: actual guest observations and a separately identified Win32 oracle.
if(NOT BUILD_TESTING)
    return()
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/conformance_matrix.py" program-id
    OUTPUT_VARIABLE conformance_program_id OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/shared/guardian/Conformance.h" "${PROJECT_SOURCE_DIR}/shared/guardian/ConformanceProgram.h"
    "${PROJECT_SOURCE_DIR}/guest/fixtures/PeConformance.cpp" "${PROJECT_SOURCE_DIR}/guest/fixtures/PeExceptionProbe.asm"
    "${PROJECT_SOURCE_DIR}/guest/fixtures/PeRuntimeApi.h" "${PROJECT_SOURCE_DIR}/shared/guardian/Memory.h"
    "${PROJECT_SOURCE_DIR}/shared/guardian/Exception.h")
if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(conformance_core guardian_boot_core)
else()
    set(conformance_core guardian_kvm)
endif()
add_executable(guest_conformance_core_tests test/GuestConformanceCoreTests.cpp)
if(WIN32)
    target_sources(guest_conformance_core_tests PRIVATE guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    target_link_libraries(guest_conformance_core_tests PRIVATE guardian_abi)
else()
    target_link_libraries(guest_conformance_core_tests PRIVATE guardian_guest_core)
endif()
add_test(NAME guest_conformance_core COMMAND guest_conformance_core_tests)
set_tests_properties(guest_conformance_core PROPERTIES TIMEOUT 60)
if(WIN32 OR GUARDIAN_TEST_KVM)
    add_executable(guest_conformance_boot_tests test/ConformanceBootTests.cpp)
    target_link_libraries(guest_conformance_boot_tests PRIVATE ${conformance_core})
    target_compile_definitions(guest_conformance_boot_tests PRIVATE GUARDIAN_CONFORMANCE_PROGRAM_ID="${conformance_program_id}")
    if(WIN32)
        add_dependencies(guest_conformance_boot_tests guardian_kernel_conformance)
        set(conformance_kernel $<TARGET_FILE:guardian_kernel_conformance>)
    else()
        set(conformance_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-conformance.gk")
    endif()
    add_test(NAME guest_conformance_boot COMMAND guest_conformance_boot_tests "${conformance_kernel}" "${PROJECT_BINARY_DIR}/conformance-$<CONFIG>")
    set_tests_properties(guest_conformance_boot PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
endif()
if(WIN32 AND MSVC)
    enable_language(ASM_MASM)
    add_executable(conformance_reference guest/fixtures/PeConformance.cpp guest/fixtures/PeExceptionProbe.asm)
    target_link_libraries(conformance_reference PRIVATE guardian_abi)
    target_compile_definitions(conformance_reference PRIVATE GUARDIAN_NATIVE_REFERENCE=1)
    target_compile_definitions(conformance_reference PRIVATE GUARDIAN_CONFORMANCE_PROGRAM_ID="${conformance_program_id}")
    target_compile_options(conformance_reference PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/W4;/WX;/utf-8;/permissive->")
    add_test(NAME conformance_windows_reference COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/conformance_matrix.py"
        reference $<TARGET_FILE:conformance_reference> "${PROJECT_BINARY_DIR}/conformance-reference-$<CONFIG>")
    set_tests_properties(conformance_windows_reference PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE)
    add_dependencies(guardian_reference guest_conformance_core_tests guest_conformance_boot_tests conformance_reference)
endif()
foreach(conformance_test IN ITEMS guest_conformance_core_tests guest_conformance_boot_tests)
    if(TARGET ${conformance_test})
        if(MSVC)
            target_compile_definitions(${conformance_test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_compile_options(${conformance_test} PRIVATE /W4 /WX /utf-8 /permissive-)
        else()
            target_compile_options(${conformance_test} PRIVATE -Wall -Wextra -Werror)
        endif()
    endif()
endforeach()
add_test(NAME conformance_matrix_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/ConformanceMatrixTests.py")
set_tests_properties(conformance_matrix_tools PROPERTIES TIMEOUT 30)
