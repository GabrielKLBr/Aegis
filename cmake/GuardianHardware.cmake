if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(guardian_hardware_core guardian_boot_core)
    target_link_libraries(guardian_boot_core PUBLIC setupapi advapi32 user32)
else()
    set(guardian_hardware_core guardian_kvm)
endif()
target_sources(${guardian_hardware_core} PRIVATE src/microvm/hardware/Profile.cpp src/microvm/hardware/Package.cpp src/microvm/hardware/DriverBackend.cpp)
if(WIN32)
    add_dependencies(guardian-vm guardian_driver_api)
    add_custom_command(TARGET guardian-vm POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        $<TARGET_FILE:guardian_driver_api> "$<TARGET_FILE_DIR:guardian-vm>/guardian-driver-api.gkd" VERBATIM)
    add_custom_target(guardian_hardware_image_audit
        COMMAND $<TARGET_FILE:guardian_boot> --check $<TARGET_FILE:guardian_kernel_hardware>
        DEPENDS guardian_boot guardian_kernel_hardware VERBATIM)
    add_dependencies(guardian_guest guardian_hardware_image_audit)
else()
    set(GUARDIAN_DRIVER_FIXTURE_DIR "${GUARDIAN_KVM_GUEST_DIR}/drivers" CACHE PATH "Native guest driver fixture directory")
    if(EXISTS "${GUARDIAN_DRIVER_FIXTURE_DIR}/ntoskrnl.exe")
        add_custom_command(TARGET guardian-vm POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
            "${GUARDIAN_DRIVER_FIXTURE_DIR}/ntoskrnl.exe" "$<TARGET_FILE_DIR:guardian-vm>/guardian-driver-api.gkd" VERBATIM)
    endif()
endif()
if(BUILD_TESTING)
    add_executable(hardware_completion_tests test/HardwareCompletionTests.cpp)
    target_link_libraries(hardware_completion_tests PRIVATE ${guardian_hardware_core})
    if(MSVC)
        target_compile_definitions(hardware_completion_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(hardware_completion_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    else()
        target_compile_options(hardware_completion_tests PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME hardware_projection COMMAND hardware_completion_tests projection "${PROJECT_BINARY_DIR}/hardware-projection-$<CONFIG>")
    if(WIN32)
        add_dependencies(hardware_completion_tests guardian_kernel_hardware guardian_driver_probe guardian_driver_failing guardian_kernel_runtime)
        set(hardware_driver_kernel $<TARGET_FILE:guardian_kernel_hardware>)
        set(hardware_runtime_kernel $<TARGET_FILE:guardian_kernel_runtime>)
        set(hardware_fixtures $<TARGET_FILE_DIR:guardian_driver_probe>)
    elseif(GUARDIAN_TEST_KVM)
        set(hardware_driver_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-hardware.gk")
        set(hardware_runtime_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-runtime.gk")
        set(hardware_fixtures "${GUARDIAN_DRIVER_FIXTURE_DIR}")
    endif()
    if(WIN32 OR GUARDIAN_TEST_KVM)
        add_test(NAME hardware_packages COMMAND hardware_completion_tests packages "${PROJECT_BINARY_DIR}/hardware-packages-$<CONFIG>" "${hardware_fixtures}")
        add_test(NAME hardware_driver COMMAND hardware_completion_tests driver "${PROJECT_BINARY_DIR}/hardware-driver-$<CONFIG>" "${hardware_driver_kernel}" "${hardware_fixtures}")
        add_test(NAME hardware_runtime COMMAND hardware_completion_tests runtime "${PROJECT_BINARY_DIR}/hardware-runtime-$<CONFIG>" "${hardware_runtime_kernel}")
        set_tests_properties(hardware_driver hardware_runtime PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE)
        add_test(NAME hardware_manager COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/test_hardware_manager.py"
            $<TARGET_FILE:guardian-vm> "${hardware_driver_kernel}" "${hardware_fixtures}" "${PROJECT_BINARY_DIR}/hardware-manager-$<CONFIG>")
        set_tests_properties(hardware_manager PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    endif()
    add_executable(hardware_tests test/HardwareTests.cpp src/microvm/state/VmManager.cpp)
    target_link_libraries(hardware_tests PRIVATE ${guardian_hardware_core})
    if(MSVC)
        target_compile_definitions(hardware_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(hardware_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    else()
        target_compile_options(hardware_tests PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME hardware_profile COMMAND hardware_tests core "${PROJECT_BINARY_DIR}/hardware-core-$<CONFIG>")
    set_tests_properties(hardware_profile PROPERTIES TIMEOUT 30)
    if(WIN32)
        add_dependencies(hardware_tests guardian_kernel guardian_kernel_cpu)
        add_test(NAME hardware_boot COMMAND hardware_tests boot "${PROJECT_BINARY_DIR}/hardware-boot-$<CONFIG>"
            $<TARGET_FILE:guardian_kernel> $<TARGET_FILE:guardian_kernel_cpu>)
        add_dependencies(guardian_host hardware_tests)
        add_dependencies(guardian_reference hardware_tests)
    elseif(GUARDIAN_TEST_KVM)
        add_test(NAME hardware_boot COMMAND hardware_tests boot "${PROJECT_BINARY_DIR}/hardware-boot-$<CONFIG>"
            "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel.gk" "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-cpu.gk")
    endif()
    if(TEST hardware_boot)
        set_tests_properties(hardware_boot PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE)
    endif()
endif()
