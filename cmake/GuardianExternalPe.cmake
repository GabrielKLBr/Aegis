foreach(kind IN ITEMS tracker leaf bridge delay reject late widget1 widget2)
    if(kind STREQUAL tracker)
        set(probe_kind 0)
    elseif(kind STREQUAL leaf)
        set(probe_kind 1)
    elseif(kind STREQUAL bridge)
        set(probe_kind 2)
    elseif(kind STREQUAL delay)
        set(probe_kind 3)
    elseif(kind STREQUAL reject)
        set(probe_kind 4)
    elseif(kind STREQUAL late)
        set(probe_kind 6)
    else()
        set(probe_kind 5)
    endif()
    add_library(guardian_external_${kind} SHARED guest/fixtures/Pe142Dll.cpp guest/Memory.cpp)
    guardian_external_flags(guardian_external_${kind})
    target_compile_definitions(guardian_external_${kind} PRIVATE PROBE_KIND=${probe_kind})
    target_link_options(guardian_external_${kind} PRIVATE /ENTRY:DllEntry)
    set_target_properties(guardian_external_${kind} PROPERTIES OUTPUT_NAME guardian-${kind})
    if(NOT kind STREQUAL tracker)
        target_link_libraries(guardian_external_${kind} PRIVATE guardian_external_tracker)
    endif()
    if(kind MATCHES "widget([12])")
        target_compile_definitions(guardian_external_${kind} PRIVATE WIDGET_VALUE=${CMAKE_MATCH_1})
        set_target_properties(guardian_external_${kind} PROPERTIES OUTPUT_NAME widget
            RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/external/$<CONFIG>/${kind}"
            ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/external-imports/$<CONFIG>/${kind}")
    endif()
endforeach()
