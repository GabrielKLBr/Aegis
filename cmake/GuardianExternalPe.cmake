enable_language(RC)
function(guardian_external_flags target)
    target_link_libraries(${target} PRIVATE guardian_abi)
    target_compile_definitions(${target} PRIVATE GUARDIAN_SCALABLE_PE=1)
    target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/guest/fixtures")
    set_target_properties(${target} PROPERTIES MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY ""
        VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE
        RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/external/$<CONFIG>"
        ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/external-imports/$<CONFIG>")
    target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/W4;/WX;/utf-8;/permissive-;/EHs-c-;/GR-;/Zl;/GS-;/JMC->")
    target_link_options(${target} PRIVATE /NODEFAULTLIB /INCREMENTAL:NO /MANIFEST:NO /DYNAMICBASE /FIXED:NO /DEBUG:NONE)
endfunction()
