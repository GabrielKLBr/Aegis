option(GUARDIAN_BUILD_WIN32_NATIVE "Build the phase 14.4 Win32 guest runtime" ${GUARDIAN_BUILD_NATIVE_NT})
set(GUARDIAN_APISET_REFERENCE_DLL "" CACHE FILEPATH "Legally supplied Windows 10 apisetschema.dll; read as data only")
if(NOT WIN32 OR NOT GUARDIAN_BUILD_WIN32_NATIVE OR NOT TARGET guardian_kernel_native_nt)
    return()
endif()
foreach(profile IN ITEMS win7 win10 win11)
    set(generated "${PROJECT_BINARY_DIR}/win32-generated/${profile}")
    file(MAKE_DIRECTORY "${generated}")
    add_custom_command(OUTPUT "${generated}/kernelbase.def" "${generated}/kernel32.def"
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/win32_runtime.py" exports "${generated}/kernelbase.def" "${generated}/kernel32.def" --profile ${profile}
        DEPENDS tools/win32_runtime.py guest/fixtures/Win32Base.cpp guest/fixtures/Win32Environment.inl guest/fixtures/Win32Files.inl guest/fixtures/Win32Async.inl guest/fixtures/Win32Threads.inl VERBATIM)
    add_library(guardian_kernelbase_${profile} SHARED guest/fixtures/Win32Base.cpp guest/fixtures/Win32Call.asm guest/Memory.cpp guest/StackProbe.asm "${generated}/kernelbase.def")
    guardian_external_flags(guardian_kernelbase_${profile})
    target_compile_definitions(guardian_kernelbase_${profile} PRIVATE GUARDIAN_NATIVE_NT=1)
    target_link_libraries(guardian_kernelbase_${profile} PRIVATE guardian_native_ntdll guardian_external_runtime)
    target_link_options(guardian_kernelbase_${profile} PRIVATE /ENTRY:KbDllEntry /INCLUDE:_tls_used)
    set_target_properties(guardian_kernelbase_${profile} PROPERTIES OUTPUT_NAME kernelbase RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32/$<CONFIG>/${profile}" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32-imports/$<CONFIG>/${profile}")
    add_library(guardian_kernel32_${profile} SHARED guest/fixtures/Win32Forward.cpp "${generated}/kernel32.def")
    guardian_external_flags(guardian_kernel32_${profile})
    target_link_options(guardian_kernel32_${profile} PRIVATE /NOENTRY)
    set_target_properties(guardian_kernel32_${profile} PROPERTIES OUTPUT_NAME kernel32 RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32/$<CONFIG>/${profile}" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32-imports/$<CONFIG>/${profile}")
    add_dependencies(guardian_kernel32_${profile} guardian_kernelbase_${profile})
    file(WRITE "${generated}/memory.def" "LIBRARY api-ms-win-core-memory-l1-1-0\nEXPORTS\nVirtualAlloc\nVirtualFree\nVirtualProtect\nVirtualQuery\n")
    set(alias "${PROJECT_BINARY_DIR}/guest/win32-imports/$<CONFIG>/${profile}/memory-api.lib")
    add_custom_command(OUTPUT "${alias}" COMMAND "${CMAKE_COMMAND}" -E make_directory "${PROJECT_BINARY_DIR}/guest/win32-imports/$<CONFIG>/${profile}"
        COMMAND "${CMAKE_AR}" /NOLOGO /MACHINE:X64 "/DEF:${generated}/memory.def" "/OUT:${alias}" DEPENDS "${generated}/memory.def" VERBATIM)
    add_custom_target(guardian_win32_alias_${profile} DEPENDS "${alias}")
    add_executable(guardian_win32_application_${profile} guest/fixtures/Win32Application.cpp guest/fixtures/Win32Reference.rc guest/Memory.cpp guest/StackProbe.asm)
    guardian_external_flags(guardian_win32_application_${profile})
    target_link_options(guardian_win32_application_${profile} PRIVATE /ENTRY:GuardianEntry /SUBSYSTEM:CONSOLE)
    target_link_libraries(guardian_win32_application_${profile} PRIVATE "${alias}" guardian_kernel32_${profile} guardian_native_ntdll)
    add_dependencies(guardian_win32_application_${profile} guardian_win32_alias_${profile})
    set_target_properties(guardian_win32_application_${profile} PROPERTIES OUTPUT_NAME guardian-win32 RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32/$<CONFIG>/${profile}")
endforeach()
add_executable(guardian_win32_child guest/fixtures/Win32Child.cpp guest/Memory.cpp guest/StackProbe.asm)
guardian_external_flags(guardian_win32_child)
target_link_options(guardian_win32_child PRIVATE /ENTRY:GuardianEntry /SUBSYSTEM:CONSOLE)
target_link_libraries(guardian_win32_child PRIVATE guardian_kernel32_win10 guardian_native_ntdll)
set_target_properties(guardian_win32_child PROPERTIES OUTPUT_NAME guardian-win32-child RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32/$<CONFIG>")
add_library(guardian_win32_plugin SHARED guest/fixtures/Win32Plugin.cpp)
guardian_external_flags(guardian_win32_plugin)
target_link_libraries(guardian_win32_plugin PRIVATE guardian_kernel32_win10)
target_link_options(guardian_win32_plugin PRIVATE /ENTRY:Win32PluginEntry)
set_target_properties(guardian_win32_plugin PROPERTIES OUTPUT_NAME guardian-win32-plugin RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/win32/$<CONFIG>")
add_executable(guardian_kernel_win32)
get_target_property(win32_sources guardian_kernel_native_nt SOURCES)
target_sources(guardian_kernel_win32 PRIVATE ${win32_sources})
target_link_libraries(guardian_kernel_win32 PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_native_nt ${property})
    set_property(TARGET guardian_kernel_win32 PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_win32 PRIVATE GUARDIAN_WIN32_NATIVE=1)
set_target_properties(guardian_kernel_win32 PROPERTIES OUTPUT_NAME guardian-kernel-win32 SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_win32 guardian_pe_fixtures guardian_runtime_fixtures guardian_complete_fixtures guardian_gui_runtime)
add_custom_command(TARGET guardian_kernel_win32 POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_win32> VERBATIM)
if(BUILD_TESTING)
    add_executable(win32_apiset_tests test/Win32ApiSetTests.cpp)
    target_compile_options(win32_apiset_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_executable(win32_windows_reference_tests test/Win32WindowsReferenceTests.cpp)
    target_compile_options(win32_windows_reference_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME win32_windows_reference COMMAND win32_windows_reference_tests)
    set_tests_properties(win32_windows_reference PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
    add_executable(win32_native_core_tests test/Win32NativeCoreTests.cpp guest/NativeServices.cpp guest/Volume.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    target_link_libraries(win32_native_core_tests PRIVATE guardian_abi)
    target_compile_definitions(win32_native_core_tests PRIVATE GUARDIAN_SCALABLE_PE=1 GUARDIAN_NATIVE_NT=1 GUARDIAN_WIN32_NATIVE=1)
    target_compile_options(win32_native_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME win32_native_core COMMAND win32_native_core_tests)
    if(GUARDIAN_APISET_REFERENCE_DLL)
        add_test(NAME win32_apiset_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/Win32RuntimeToolsTests.py" $<TARGET_FILE:win32_apiset_tests> "${GUARDIAN_APISET_REFERENCE_DLL}")
        add_test(NAME win32_runtime_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/Win32IntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_APISET_REFERENCE_DLL}" --evidence "${PROJECT_BINARY_DIR}/win32-$<CONFIG>")
        set_tests_properties(win32_runtime_integration PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
    endif()
endif()
