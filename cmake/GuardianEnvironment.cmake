# Phase 12E: typed synthetic profiles generated by real owned guest programs.
if(NOT BUILD_TESTING)
    return()
endif()
if(WIN32)
    if(NOT TARGET guardian_boot_core)
        return()
    endif()
    set(environment_core guardian_boot_core)
else()
    set(environment_core guardian_kvm)
endif()
add_executable(environment_core_tests test/EnvironmentCoreTests.cpp)
add_executable(environment_boot_tests test/EnvironmentBootTests.cpp)
foreach(environment_target IN ITEMS environment_core_tests environment_boot_tests)
    target_link_libraries(${environment_target} PRIVATE ${environment_core})
    if(WIN32)
        target_sources(${environment_target} PRIVATE guest/Volume.cpp guest/Scheduler.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp)
    else()
        target_link_libraries(${environment_target} PRIVATE guardian_guest_core)
    endif()
    if(MSVC)
        target_compile_definitions(${environment_target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(${environment_target} PRIVATE /W4 /WX /utf-8 /permissive-)
    else()
        target_compile_options(${environment_target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
add_test(NAME environment_core COMMAND environment_core_tests "${PROJECT_BINARY_DIR}/environment-core-$<CONFIG>")
set_tests_properties(environment_core PROPERTIES TIMEOUT 30)
if(WIN32 OR GUARDIAN_TEST_KVM)
    if(WIN32)
        set(environment_kernel $<TARGET_FILE:guardian_kernel_environment>)
        set(environment_reader $<TARGET_FILE:guardian_docs_app>)
        set(environment_legacy $<TARGET_FILE:guardian_kernel_complete>)
        add_dependencies(environment_boot_tests guardian_kernel_environment)
    else()
        set(environment_kernel "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-environment.gk")
        set(environment_reader "${GUARDIAN_KVM_GUEST_DIR}/guardian-docs.exe")
        set(environment_legacy "${GUARDIAN_KVM_GUEST_DIR}/guardian-kernel-complete.gk")
    endif()
    add_test(NAME environment_boot COMMAND environment_boot_tests "${environment_kernel}" "${PROJECT_BINARY_DIR}/environment-boots-$<CONFIG>")
    set_tests_properties(environment_boot PROPERTIES TIMEOUT 240 RUN_SERIAL TRUE)
    add_test(NAME environment_lifecycle COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/EnvironmentLifecycleTests.py"
        $<TARGET_FILE:guardian-vm> "${environment_kernel}" "${environment_legacy}" "${environment_reader}"
        "${PROJECT_BINARY_DIR}/environment-boots-$<CONFIG>/profiles.json" "${PROJECT_BINARY_DIR}/environment-lifecycle-$<CONFIG>")
    set_tests_properties(environment_lifecycle PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE DEPENDS environment_boot)
endif()
if(WIN32 AND TARGET guardian_reference)
    add_dependencies(guardian_reference environment_core_tests environment_boot_tests)
endif()
