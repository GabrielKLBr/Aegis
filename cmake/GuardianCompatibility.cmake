# Phase 14.1: versioned target selection, immutable runtime bindings and inventory.
if(WIN32 AND TARGET guardian_boot_core)
    set(nt_core guardian_boot_core)
    target_link_libraries(${nt_core} PUBLIC bcrypt)
elseif(TARGET guardian_kvm)
    set(nt_core guardian_kvm)
    target_link_libraries(${nt_core} PUBLIC OpenSSL::Crypto)
else()
    return()
endif()
target_sources(${nt_core} PRIVATE src/microvm/compatibility/Binding.cpp)
if(BUILD_TESTING)
    add_executable(nt_compatibility_tests test/NtCompatibilityTests.cpp)
    target_link_libraries(nt_compatibility_tests PRIVATE ${nt_core})
    if(MSVC)
        target_compile_definitions(nt_compatibility_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(nt_compatibility_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    endif()
    add_test(NAME nt_compatibility_core COMMAND nt_compatibility_tests)
    add_test(NAME nt_compatibility_inventory COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/NtCompatibilityInventoryTests.py" $<TARGET_FILE:nt_compatibility_tests>)
    if(WIN32 AND TARGET guardian_kernel_pe_gui)
        add_executable(nt_compatibility_boot_tests test/NtCompatibilityBootTests.cpp)
        target_link_libraries(nt_compatibility_boot_tests PRIVATE ${nt_core})
        target_compile_definitions(nt_compatibility_boot_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_compile_options(nt_compatibility_boot_tests PRIVATE /W4 /WX /utf-8 /permissive-)
        add_dependencies(nt_compatibility_boot_tests guardian_kernel_pe_gui guardian_kernel_cpu guardian_gui_application)
        add_test(NAME nt_compatibility_boot COMMAND nt_compatibility_boot_tests
            $<TARGET_FILE:guardian_kernel_pe_gui> $<TARGET_FILE:guardian_gui_application> $<TARGET_FILE:guardian_kernel_cpu>
            "${PROJECT_BINARY_DIR}/nt-compatibility-$<CONFIG>")
        set_tests_properties(nt_compatibility_boot PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE SKIP_RETURN_CODE 77)
        add_test(NAME nt_compatibility_cli COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/NtCompatibilityCliTests.py"
            $<TARGET_FILE:guardian-gui-pe> $<TARGET_FILE:guardian_kernel_pe_gui> $<TARGET_FILE:guardian_gui_application>
            $<TARGET_FILE:guardian_gui_user32> "${PROJECT_BINARY_DIR}/nt-cli-$<CONFIG>")
        set_tests_properties(nt_compatibility_cli PROPERTIES TIMEOUT 90 RUN_SERIAL TRUE)
    endif()
endif()
