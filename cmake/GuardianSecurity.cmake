option(GUARDIAN_BUILD_SECURITY "Build phase 14.6 guest security and services" ${GUARDIAN_BUILD_CRT})
if(NOT WIN32 OR NOT GUARDIAN_BUILD_SECURITY OR NOT TARGET guardian_kernel_crt)
    return()
endif()
set(security_generated "${PROJECT_BINARY_DIR}/security-generated")
add_custom_command(OUTPUT "${security_generated}/advapi32.def" "${security_generated}/sechost.def" "${security_generated}/userenv.def" "${security_generated}/coverage.json"
    COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/security_runtime.py" exports "${security_generated}"
    DEPENDS tools/security_runtime.py guest/fixtures/SecurityAdvapi.cpp guest/fixtures/SecurityIdentity.inl guest/fixtures/SecurityServices.inl guest/fixtures/SecurityEvents.inl VERBATIM)
add_library(guardian_security_advapi32 SHARED guest/fixtures/SecurityAdvapi.cpp guest/fixtures/SecurityCall.asm guest/Memory.cpp guest/StackProbe.asm "${security_generated}/advapi32.def")
guardian_external_flags(guardian_security_advapi32)
target_link_libraries(guardian_security_advapi32 PRIVATE guardian_crt_kernel32)
target_link_options(guardian_security_advapi32 PRIVATE /ENTRY:SecurityDllEntry)
set_target_properties(guardian_security_advapi32 PROPERTIES OUTPUT_NAME advapi32 RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/security/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/security-imports/$<CONFIG>")
foreach(dll IN ITEMS sechost userenv)
    add_library(guardian_security_${dll} SHARED guest/fixtures/Win32Forward.cpp "${security_generated}/${dll}.def")
    guardian_external_flags(guardian_security_${dll})
    target_link_libraries(guardian_security_${dll} PRIVATE guardian_security_advapi32)
    target_link_options(guardian_security_${dll} PRIVATE /NOENTRY)
    set_target_properties(guardian_security_${dll} PROPERTIES OUTPUT_NAME ${dll} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/security/$<CONFIG>" ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/security-imports/$<CONFIG>")
    add_dependencies(guardian_security_${dll} guardian_security_advapi32)
endforeach()
add_executable(guardian_kernel_security)
get_target_property(security_sources guardian_kernel_crt SOURCES)
target_sources(guardian_kernel_security PRIVATE ${security_sources} guest/Security.cpp)
target_link_libraries(guardian_kernel_security PRIVATE guardian_abi)
foreach(property IN ITEMS INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(value guardian_kernel_crt ${property})
    set_property(TARGET guardian_kernel_security PROPERTY ${property} "${value}")
endforeach()
target_compile_definitions(guardian_kernel_security PRIVATE GUARDIAN_SECURITY_NATIVE=1)
set_target_properties(guardian_kernel_security PROPERTIES OUTPUT_NAME guardian-kernel-security SUFFIX .gk RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/$<CONFIG>" MSVC_RUNTIME_CHECKS "" MSVC_RUNTIME_LIBRARY "" VS_JUST_MY_CODE_DEBUGGING FALSE INTERPROCEDURAL_OPTIMIZATION FALSE)
add_dependencies(guardian_kernel_security guardian_pe_fixtures guardian_runtime_fixtures guardian_complete_fixtures guardian_gui_runtime)
add_custom_command(TARGET guardian_kernel_security POST_BUILD COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/normalize_kernel_image.py" $<TARGET_FILE:guardian_kernel_security> VERBATIM)
foreach(kind IN ITEMS application read service orphan peer crash fault)
    add_executable(guardian_security_${kind} guest/fixtures/SecurityApplication.cpp)
    target_compile_options(guardian_security_${kind} PRIVATE /W4 /WX /utf-8 /permissive- /EHsc)
    target_compile_definitions(guardian_security_${kind} PRIVATE "SECURITY_${kind}=1")
    target_link_libraries(guardian_security_${kind} PRIVATE guardian_crt_kernel32 guardian_security_advapi32 guardian_security_userenv)
    target_link_options(guardian_security_${kind} PRIVATE /INCREMENTAL:NO /MANIFEST:NO /DEBUG:NONE)
    set(security_output "guardian-security-${kind}")
    if(kind STREQUAL application)
        set(security_output guardian-security)
    endif()
    set_target_properties(guardian_security_${kind} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL MSVC_RUNTIME_CHECKS "" OUTPUT_NAME ${security_output} RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/guest/security/$<CONFIG>")
endforeach()
if(BUILD_TESTING)
    add_executable(security_contract_tests test/SecurityContractTests.cpp)
    target_link_libraries(security_contract_tests PRIVATE guardian_abi)
    target_compile_definitions(security_contract_tests PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(security_contract_tests PRIVATE /W4 /WX /utf-8)
    add_test(NAME security_contract COMMAND security_contract_tests)
    add_executable(security_core_tests test/SecurityCoreTests.cpp guest/Security.cpp guest/Volume.cpp guest/ProcessManager.cpp guest/MemoryManager.cpp guest/Scheduler.cpp)
    target_link_libraries(security_core_tests PRIVATE guardian_abi)
    target_compile_definitions(security_core_tests PRIVATE GUARDIAN_SECURITY_NATIVE=1 GUARDIAN_NATIVE_NT=1 GUARDIAN_SCALABLE_PE=1 _CRT_SECURE_NO_WARNINGS)
    target_compile_options(security_core_tests PRIVATE /W4 /WX /utf-8 /permissive-)
    add_test(NAME security_core COMMAND security_core_tests)
    add_executable(security_windows_reference test/SecurityWindowsReference.cpp)
    target_link_libraries(security_windows_reference PRIVATE advapi32 userenv)
    target_compile_definitions(security_windows_reference PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(security_windows_reference PRIVATE /W4 /WX /utf-8)
    add_test(NAME security_windows_reference COMMAND security_windows_reference)
    add_test(NAME security_runtime_tools COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/SecurityRuntimeToolsTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}")
    add_test(NAME security_runtime_integration COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/test/SecurityIntegrationTests.py" --build "${PROJECT_BINARY_DIR}" --config "$<CONFIG>" --reference "${GUARDIAN_CRT_REFERENCE_DIR}" --schema-reference "${GUARDIAN_APISET_REFERENCE_DLL}" --evidence "${PROJECT_BINARY_DIR}/security-$<CONFIG>")
    set_tests_properties(security_runtime_integration PROPERTIES TIMEOUT 180 RUN_SERIAL TRUE)
endif()
